rebrand_music_description":"Bao gồm các bài nhạc và hiệu ứng âm thanh tiêu chuẩn để đáp ứng mọi nhu cầu của bạn","pro_video_ideal_description":"Phù hợp nhất cho những người sáng tạo thường xuyên cần video","request_a_quote":"Yêu cầu báo giá","save_discount_with_code":"\u003cstrong\u003eTIẾT KIỆM __PERCENTAGE__\u003c/strong\u003e khi mua gói ảnh tiếp theo với mã \u003cstrong\u003e__CODE__\u003c/strong\u003e","save_percentage_banner_text":"Tiết kiệm __PERCENTAGE__% trong thời gian có hạn vào tháng đầu tiên","see_more_purchase_options":"Xem thêm các tùy chọn mua hàng","select_the_resolution":"Chọn độ phân giải:","single_download":"Một lượt tải xuống","single_download_alt":"Một lượt tải xuống","single_seat":"Một người dùng","single_use_standard_license_creative_and_digital_use":"Sử dụng một lần, giấy phép tiêu chuẩn để sử dụng kỹ thuật số và kỹ thuật số sáng tạo","site-header:image_downloads":"Ảnh tải xuống","site-header:video_downloads":"Lượt tải video","smb_banner_description":"Chúng tôi đảm bảo doanh nghiệp nhỏ hoặc vừa của bạn được bảo vệ cấp phép phù hợp với nhu cầu.\n\nTiếp sức cho toàn bộ đội ngũ với toàn quyền tải xuống, chỉnh sửa, truy cập an toàn và lưu trữ mọi tài sản mà doanh nghiệp của bạn cấp phép.","smb_banner_title":"Dành cho doanh nghiệp nhỏ và vừa","smb_flex_card_description":"Cấp phép và sử dụng ảnh, video và nhạc cho tối đa __NUM__ thành viên","smb_image_allotment_description":"Lượt tải xuống ảnh mỗi tháng","smb_image_card_description":"Cấp phép và sử dụng ảnh cho tối đa __NUM__ thành viên","smb_pricing_card_license_under_business":"Xin cấp phép trên tư cách doanh nghiệp thay vì cá nhân","smb_pricing_card_read_more_bullet_add_remove_members":"Thêm hoặc xóa tối đa __NUM__ thành viên bất cứ lúc nào","smb_pricing_card_read_more_bullet_add_remove_team_members":"Thêm hoặc xóa thành viên nhóm bất cứ lúc nào","smb_pricing_card_read_more_bullet_content_research":"Tiếp cận các nghiên cứu về nội dung, truy cập để tải xuống bản xem trước không có dấu bản quyền","smb_pricing_card_read_more_bullet_expert_support_onboarding":"Hỗ trợ và hướng dẫn nhập môn từ chuyên gia giúp nhóm của bạn bắt đầu","smb_pricing_card_read_more_bullet_human_review_of_content":"Đánh giá của con người về nội dung đã tạo","smb_pricing_card_read_more_bullet_members_can":"Các thành viên được thêm có thể xin cấp phép, tải xuống và sử dụng nội dung","smb_pricing_card_read_more_bullet_rights":"Quyền để thành viên lưu trữ và chia sẻ nội dung trên máy chủ công ty (drive chung, DAM, đám mây, v.v.)","smb_pricing_card_read_more_bullet_store_content":"Khả năng lưu trữ nội dung trên công cụ DAM của công ty, Tích hợp API, Đăng nhập một lần bằng SAML","smb_pricing_card_read_more_title":"Mọi thứ đều có trong gói đăng ký cá nhân cùng với:","smb_pricing_card_standard_and_enhanced":"Giấy phép tiêu chuẩn và nâng cao","smb_pricing_card_tap_into_premium_stock":"Khai thác những nội dung cao cấp do nghệ sĩ sáng tạo với tính năng cấp phép theo yêu cầu và nhiều tiện ích khác:","smb_teams_read_more_item_1":"An tâm tận hưởng với các giải pháp cấp phép toàn diện, cung cấp bồi thường đầy đủ, quyền sử dụng cho mục đích nhạy cảm và quyền chuyển nhượng cho bên thứ ba.","smb_teams_read_more_item_2":"Tận hưởng các tiện ích tích hợp SSO và DAM miễn phí, nội dung theo yêu cầu từ Đội ngũ nghiên cứu chuyên biệt và quy trình làm việc tự động được tối ưu hóa từ Nhân viên quản lý tài khoản kỹ thuật của chúng tôi.","smb_teams_read_more_item_3":"Giá cước cá nhân hóa.","smb_teams_read_more_title":"Mọi thứ đều có trong gói đăng ký nhóm cùng với:","smb_teams_thank_you":"Cảm ơn bạn đã yêu cầu!","smb_teams_thank_you_message":"Một thành viên trong nhóm chúng tôi sẽ sớm liên lạc với bạn! Trong lúc chờ đợi, hãy tìm hiểu cách chúng tôi giúp khách hàng phát huy khả năng sáng tạo.","smb_tell_us_about_yourself":"Cho chúng tôi được biết thêm về bạn","standard_license_creative_and_print_use":"Giấy phép tiêu chuẩn để sử dụng kỹ thuật số và in ấn sáng tạo","standard_license_digital_use":"Giấy phép tiêu chuẩn để sử dụng kỹ thuật số sáng tạo","standard_or_enhanced_licenses":"Giấy phép tiêu chuẩn hoặc Giấy phép nâng cao","starting_at":"Chỉ từ:","subscribe":"Đăng ký","subscribe_and_save_percentage":"Đăng ký và tiết kiệm __PERCENTAGE__%","subscribe_now_get_ai_gen":"Đăng ký ngay để nhận 100 lần tạo bằng AI mỗi tháng.","subscribe_to_gen_ai":"Đăng ký GenAI","subscribe_to_unlimited":"Đăng ký gói Không giới hạn","subscriptions":"Gói đăng ký","try_image_pack_and_save":"Hãy dùng thử gói ảnh để tiết kiệm.","unlimited_ai_generations":"100 lần tạo bằng AI mỗi tháng","unlimited_ai_generations_credits":"100 tín dụng tạo nội dung bằng AI mỗi tháng","unlimited_ai_models":"Truy cập vào nhiều mô hình AI hàng đầu từ Google, OpenAI, Runway, v.v.","unlimited_download_subscription":"Gói đăng ký không giới hạn lượt tải xuống","unlimited_downloads_subscription":"Gói đăng ký lượt tải xuống không giới hạn","unlimited_images":"Ảnh Không giới hạn","unlimited_images_pricing_card_subtitle":"Dành cho những nhà sáng tạo cần tiếp cận với nhiều lựa chọn ảnh phong phú nhất.","unlimited_multi_asset_subscription":"Gói đăng ký đa tài sản không giới hạn","unlimited_plus":"Không giới hạn Plus","unlimited_plus_pricing_card_subtitle":"Truy cập ảnh, video clip, bài nhạc chất lượng cao và tính năng tạo nội dung bằng AI – tất cả chỉ với một gói đăng ký.","unlimited_pro_from_price":"Không giới hạn + __NUMBER__ ảnh Premium từ","unlimited_royalty":"Lượt tải xuống miễn phí bản quyền không giới hạn","unlimited_select_downloads_per_month":"Chọn số lượt tải xuống mỗi tháng:","unlimited_tiers_image_downloads_per_month":"10 – 750 lượt tải xuống ảnh mỗi tháng","unlimited_tiers_image_downloads_subtitle":"Dành cho các dự án chỉ có ảnh với số lượt tải xuống nhất định mỗi tháng.","unlimited_tiers_image_packs_downloads":"2 – 25 lượt tải xuống ảnh","unlimited_tiers_image_packs_subtitle":"Dành cho dự án ảnh một lần khi bạn không cần đến gói đăng ký.","unlimited_tiers_number_million_of_our_best_assets":"Hơn 100 triệu tài sản tốt nhất của chúng tôi","unlimited_tiers_standard_license_creative_and_digital_use":"Giấy phép tiêu chuẩn để sáng tạo và sử dụng kỹ thuật số","unlimited_tiers_unlimited_images_subtitle":"Để tải xuống ảnh không giới hạn và tạo nội dung bằng AI.","unlimited_tiers_unlimited_plus_subtitle":"Để tải xuống không giới hạn ảnh, video, âm nhạc, hiệu ứng âm thanh và tạo nội dung bằng AI.","unlimited_tiers_video_downloads_per_month":"5 – 20 lượt tải xuống video mỗi tháng","unlimited_tiers_video_downloads_subtitle":"Dành cho các dự án chỉ có video với số lượt tải xuống nhất định mỗi tháng.","unlimited_tiers_video_packs_downloads":"5 – 25 lượt tải xuống video","unlimited_tiers_video_packs_subtitle":"Dành cho dự án video một lần khi bạn không cần đến gói đăng ký.","unlimited_uhp_pricing_card_subtitle":"Không giới hạn lượt tải xuống cho mọi loại tài sản. Với một mức giá thấp.","unlimited_uhp_pricing_card_title":"Giới thiệu Gói đăng ký không giới hạn MỚI.","unlimited_video_pack_card_title":"__NUMBER_OF_VIDEOS__ video __RESOLUTION__","unlock_perfect_image_plan":"Khám phá gói ảnh hoàn hảo của bạn","video-pricing:meta_description":"Khám phá video clip 4K, HD, video có sẵn miễn phí bản quyền đáp ứng được tất cả các nhu cầu của bạn. Xem các gói giá cước của chúng tôi và tiết kiệm đến 25% với nhiều lựa chọn gói video.","video-pricing:meta_title":"Giá cước và gói đăng ký video clip, video có sẵn | Shutterstock","video_only_subscription":"Gói đăng ký chỉ có video","video_pack_card_resolution":"Video __RESOLUTION__","video_pack_card_title":"Gói __NUMBER_OF_VIDEOS__ video","video_packs":"Gói video","video_packs_section_subtitle":"Mua gói video cho các dự án một lần và nhu cầu sử dụng linh hoạt.","video_packs_section_title":"Bạn cần video theo đúng tiêu chí của mình?","video_packs_title_unlimited":"Gói video Shutterstock: Nội dung đỉnh cao, không cần cam kết.","video_subscription":"Gói đăng ký video","video_subscription_lower_cased":"Gói đăng ký video","videos":"Video","whats_standard_and_enhanced":"G