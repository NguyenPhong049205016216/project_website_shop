tion:pro":"Mức giá hợp lý để mua ảnh, đồng thời nhận thêm công cụ lập kế hoạch và sắp xếp nội dung. Một người dùng.","pricing_card_editorial_use_only_link":"\u003ceditorialUseOnlyLink\u003eChỉ được phép sử dụng cho mục đích báo chí\u003c/editorialUseOnlyLink\u003e","pricing_card_essential":"Essential (4K, HD, SD)","pricing_card_get_started":"Bắt đầu","pricing_card_join_now":"Tham gia ngay","pricing_card_learn_more":"Tìm hiểu thêm","pricing_card_learn_more_about_plan":"Tìm hiểu thêm về gói đăng ký này","pricing_card_license_type_enhanced":"Giấy phép nâng cao","pricing_card_license_type_standard":"Giấy phép tiêu chuẩn","pricing_card_modal_subtitle":"Truy cập hơn 650 triệu tài sản chất lượng cao và công cụ thiết kế dễ sử dụng với gói đăng ký dành cho người dùng cá nhân của chúng tôi.","pricing_card_most_popular":"Phổ biến nhất","pricing_card_no_commitment":"không bắt cam kết","pricing_card_payment_annual_billed_upfront":"Gói đăng ký hằng năm trả trước","pricing_card_payment_monthly_no_contract":"Gói đăng ký hàng tháng, không có hợp đồng","pricing_card_payment_options":"Tùy chọn thanh toán","pricing_card_payment_yearly_billed":"Thanh toán hằng năm với mức phí __PRICE__ __CURRENCY__","pricing_card_picked_for_you":"Tuyển chọn cho bạn","pricing_card_premium":"Cao cấp","pricing_card_select_an_asset_type":"Chọn loại tài sản","pricing_card_select_license_type":"Chọn loại giấy phép","pricing_card_select_resolution":"Chọn độ phân giải","pricing_card_subtitle_credits_per_month":"Tín dụng mỗi tháng","pricing_card_subtitle_downloads_per_month":"Lượt tải xuống mỗi tháng","pricing_card_subtitle_downloads_within_year":"Lượt tải xuống (trong một năm)","pricing_card_subtitle_video_downloads_per_month":"Lượt tải xuống video mỗi tháng","pricing_card_total":"tổng","pricing_card_trusted_by_largest_companies":"Được các thương hiệu hàng đầu thế giới tin dùng","pricing_editorial_header":"Gói giá cước Shutterstock Editorial: nhận nội dung báo chí mới nhất","pricing_editorial_header_rebrand":"G