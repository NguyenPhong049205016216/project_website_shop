E__","video_standard_license_description_v2":"Hạn chế sử dụng trong kỹ thuật số và quảng cáo. Không sử dụng cho truyền hình hoặc phim ảnh.","view_all_image_plans":"Xem tất cả gói ảnh","view_cart":"Xem giỏ hàng","workspaces:license_type_enhanced_license":"Giấy phép nâng cao","workspaces:license_type_standard_license":"Giấy phép tiêu chuẩn","yearly":"Hằng năm","your_price":"Giá bán cho bạn"},"packUpsells":{"image_add_downloads_now":"Thêm lượt tải xuống ngay","od_pack_subscriber_price":"Giá bán cho người đăng ký","od_pack_upsells_alert_label":"Bạn sắp hết lượt tải xuống: Còn __CREDIT_UTILIZATON__","od_pack_upsells_alert_label_subscriber_deal":"Ưu đãi cho người đăng ký! Giảm giá \u003cw\u003e__DISCOUNT__% khi tải xuống thêm\u003cw\u003e","od_pack_upsells_alert_label_zero_downloads":"Bạn đã dùng hết lượt tải xuống.","od_pack_upsells_description_discount":"Ưu đãi \u003cw\u003egiảm giá __DISCOUNT__%\u003c/w\u003e cho người đăng ký!","pack_upsells_alert_label":"Bạn sắp hết tín dụng: Còn __CREDIT_UTILIZATON__","pack_upsells_alert_label_zero_credits":"Bạn đã dùng hết tín dụng.","promote_enhanced:allowed_in_merchandising":"Được phép sử dụng trên hàng hóa và bao bì","promote_enhanced:allowed_in_web_templates":"Được phép sử dụng trên mẫu web và trong sản xuất video với mọi mức ngân sách","promote_enhanced:image_pack":"Gói __COUNT__ ảnh","promote_enhanced:legal_indemnification":"Bồi thường pháp lý tối đa __AMOUNT__ USD ","promote_enhanced:legal_protection":"Để biết thêm về bảo vệ pháp lý và quyền chuyển nhượng, \u003crequestDemoLink\u003ehãy trao đổi cùng chúng tôi về Enterprise\u003c/requestDemoLink\u003e.","promote_enhanced:license":"Để xem đầy đủ thông tin chi tiết về các loại giấy phép và các tính năng có trong giấy phép, vui lòng xem \u003ctermsLink\u003eĐiều khoản dịch vụ\u003c/termsLink\u003e của chúng tôi.","promote_enhanced:limited_ooh_advertising":"Tối đa 50.000 bản in quảng cáo ngoài trời (OOH)","promote_enhanced:restrictions_in_merchandising":"Có hạn chế đối với trường hợp sử dụng trên hàng hóa và bao bì","promote_enhanced:restrictions_in_web_templates":"Có hạn chế đối với trường hợp sử dụng trên mẫu web","promote_enhanced:unlimited_ooh_advertising":"Không giới hạn số bản in quảng cáo ngoài trời (OOH)","promote_enhanced:unlimited_web_distribution":"Phân phối web không giới hạn","promote_enhanced:video_pack":"Gói __COUNT__ video"},"pricing":{"100m_high_quality_images":"Hơn 100 triệu ảnh chất lượng cao","10_image_sub_only":"Chỉ dành cho gói đăng ký 10 ảnh","30m_high_quality_videos":"Hơn 30 triệu video chất lượng cao","access_475m_high_quality_assets":"Truy cập hơn 475 triệu tài sản chất lượng cao và công cụ thiết kế dễ sử dụng. 200.000 ảnh mới được bổ sung mỗi ngày!","access_high_quality_music_and_sound_effects_powered_by_pb":"Truy cập nhạc và hiệu ứng âm thanh chất lượng cao của PremiumBeat – hoàn toàn không lo về cấp phép.","access_library_of_30m_video":"Truy cập thư viện 30 triệu video clip chân thực, chất lượng cao – hoàn toàn an tâm cấp phép.","access_unlimited_downloads":"Truy cập không giới hạn ngay lập tức","access_unlimited_for":"Truy cập không giới hạn chỉ với __PRICE__/tháng","account:monthly_no_contract_details":"Không cần cam kết, thanh toán hằng tháng","account:unlimited_credits":"Không giới hạn lượt tải xuống","activation-drawers:per_image":"mỗi ảnh","ai-image-generator-pricing:meta_description":"Tái hiện khả năng của các công cụ tạo ảnh. Trình tạo ảnh bằng AI của Shutterstock sử dụng những mô hình tốt nhất trên thị trường để tạo nên nhiều hình ảnh chuyên nghiệp. Đăng ký ngay hôm nay!","ai-image-generator-pricing:meta_title":"Giá cước gói đăng ký Trình tạo ảnh bằng AI | Shutterstock","ai_banner_create_with_confidence_heading":"Tự tin sáng tạo","ai_banner_create_with_confidence_paragraph":"An tâm sáng tạo nhiều hơn với ảnh từ AI mà bạn có thể cấp phép y như các sản phẩm ảnh tiêu chuẩn trong gói đăng ký của Shutterstock. Mô hình thế hệ AI đột phá sẽ bảo vệ quyền lợi của nghệ sĩ thông qua Quỹ dành cho Người đóng góp cấp tiến của chúng tôi, đảm bảo trả công xứng đáng cho những đóng góp của họ.","ai_banner_cta":"Xem trình tạo bằng AI của chúng tôi","ai_banner_generate_using_the_best_heading":"Tạo bằng mô hình AI tốt nhất trên thị trường","ai_banner_generate_using_the_best_paragraph":"Trình tạo ảnh bằng AI của chúng tôi sử dụng các mô hình tạo ảnh tân tiến như DALL·E và Imagen, nghĩa là bạn không cần phải là kỹ sư để tạo ra những hình ảnh tuyệt đẹp mới. Những gì bạn tưởng tượng được, chúng tôi đều có thể tạo!","ai_banner_need_to_create_more_heading":"Bạn cần tạo thêm?","ai_banner_need_to_create_more_paragraph":"Gói đăng ký AI kiến tạo Plus của chúng tôi đi kèm với __NUM_GENERATIONS__ lần tạo mỗi tháng. Cứ mỗi lần tạo được __PAGE_SIZE__ ảnh, tức là mỗi tháng bạn sẽ có __NUM_UNIQUE_IMAGES__ ảnh độc nhất vô nhị. Nhưng đừng lo, nếu cần thêm lần tạo, bạn có thể dễ dàng bổ sung cho gói đăng ký khi dùng hết.","ai_banner_title_get_full_access":"Nhận toàn quyền truy cập vào mọi tính năng của AI kiến tạo với gói đăng ký GenAI","ai_banner_title_get_full_access_pro":"Nhận toàn quyền truy cập vào mọi tính năng của AI kiến tạo với GenAI Pro","ai_banner_title_youre_almost_there":"Sắp xong rồi...","ai_gen_upsell":"Đăng ký ngay để nhận miễn phí 100 lần tạo ảnh từ AI","ai_image_generator_ai_models":"Truy cập những mô hình AI tốt nhất và mới nhất của Runway, Google, OpenAI, v.v.","ai_image_generator_ai_models_access":"Khai thác các mô hình AI hàng đầu trong ngành như Runway, Google Veo, Dall-E 3, Google Imagen, v.v.","ai_image_generator_choose_ai_model":"Chọn mô hình AI hoặc sử dụng công cụ đề xuất mô hình AI mạnh mẽ của chúng tôi","ai_image_generator_generation_credits_tool_tip":"Việc tạo ảnh có giá 1 tín dụng tạo nội dung và cho ra 4 ảnh. \u003cbr\u003eViệc chỉnh sửa ảnh tốn 1 lần tạo và cho ra 3 ảnh.\u003c/br\u003e\u003cbr\u003eViệc tạo video có giá 10 tín dụng tạo nội dung và cho ra 2 video.\u003c/br\u003e","ai_image_generator_generations_per_month_images":"__NUM_IMAGES__ lần tạo mỗi tháng (1 lần tạo được __PAGE_SIZE__ ảnh)","ai_image_generator_unique_ai_generations_per_month_images":"__NUM_GENERATIONS__ tín dụng tạo nội dung bằng AI mỗi tháng","ai_models_logo_section_title":"Sử dụng mô hình AI tốt nhất thế giới","alerts:default_pricing_alert":"Rất tiếc, đã xảy ra lỗi khi xử lý đơn hàng của bạn. Hãy thử lại sau ít phút. Nếu vẫn xảy ra lỗi, hãy \u003ccontact\u003eliên hệ với chúng tôi\u003c/contact\u003e để được hỗ trợ thêm.","alerts:no_free_trial_in_india":"Ưu đãi dùng thử miễn phí không áp dụng cho Ấn Độ","alerts:pricing_duplicate_aigen_subscription_no_rep":"Bạn đã đăng ký __PRODUCT_NAME__. Nếu cần thêm lần tạo hoặc muốn nâng cấp gói đăng ký, vui lòng \u003ccontact\u003eliên hệ với nhân viên bán hàng\u003c/contact\u003e.","alerts:pricing_duplicate_aigen_subscription_rep_contacts":"Bạn đã đăng ký __PRODUCT_NAME__. Nếu cần thêm lần tạo hoặc muốn nâng cấp gói đăng ký, vui lòng liên hệ với đại diện của bạn theo số __PHONE__ hoặc địa chỉ __EMAIL__.","alerts:pricing_duplicate_aigen_subscription_unlimited":"Bạn đã có gói đăng ký AI kiến tạo. \u003ccontact\u003eLiên hệ với chúng tôi\u003c/contact\u003e nếu muốn chuyển sang sản phẩm này.","alerts:pricing_duplicate_music_subscription":"Bạn đã có gói đăng ký này. \u003ccontact\u003eLiên hệ với chúng tôi\u003c/contact\u003e nếu bạn cần hỗ trợ thêm.","alerts:pricing_duplicate_paused_subscription":"Bạn đã có gói đăng ký này. Gói đăng ký hiện đang bị tạm dừng. Kích hoạt lại bất cứ lúc nào trên trang Gói đăng ký để tiếp tục cấp phép. \u003ccontact\u003eLiên hệ với chúng tôi\u003c/contact\u003e nếu bạn cần hỗ trợ thêm.","alerts:pricing_duplicate_subscription":"Bạn đã có gói đăng ký này. Nếu bạn cần thêm lượt tải xuống, hãy mua một Gói. \u003ccontact\u003eLiên hệ với chúng tôi\u003c/contact\u003e nếu bạn cần hỗ trợ thêm.","alerts:pricing_duplicate_unlimited_subscription":"You already have an Unlimited subscription. \u003ccontact\u003eContact us\u003c/contact\u003e if you need further assistance.","alerts:pricing_incompatible_subscription":"Liên hệ với chúng tôi \u003crequestBusinessDemo\u003etại đây\u003c/requestBusinessDemo\u003e để nhận gói dành riêng cho nhóm/doanh nghiệp của bạn.","alerts:pricing_invalid_coupon_code":"Mã phiếu mua hàng áp dụng cho khuyến mại này không hợp lệ. Vui lòng chọn đúng sản phẩm cho ưu đãi này hoặc \u003ccontact\u003eliên hệ với chúng tôi\u003c/contact\u003e để được hỗ trợ thêm.","alerts:promotion_not_eligible":"Bạn hiện có gói đăng ký đang hoạt động và không đủ điều kiện tham gia chương trình khuyến mãi này.","alerts:team_non_team_incompatible_subscription":"Bạn đã có một gói đăng ký. \u003ccontact\u003eHãy liên hệ\u003c/contact\u003e để chúng tôi giúp bạn thiết lập gói đăng ký nhóm.","annual":"Hàng năm","annual_commitment_pay_upfront_save":"Cam kết hằng năm, trả trước \u003cb\u003e(Tiết kiệm lên đến __VALUE__)\u003c/b\u003e","annual_pay_monthly":"Gói đăng ký hàng năm, thanh toán hằng tháng","annual_pay_upfront":"Gói đăng ký hằng năm trả trước","annual_pay_upfront_save":"Gói đăng ký hằng năm trả trước \u003cb\u003e(Tiết kiệm lên đến __VALUE__)\u003c/b\u003e","annual_upfront":"Gói đăng ký hằng năm trả trước","are_you_a_business":"Bạn là khách hàng doanh nghiệp?","basic_unlimited":"Gói đăng ký không giới hạn","billed_yearly":"Thanh toán hằng năm với mức phí __PRICE__","billed_yearly_at":"Thanh toán hằng năm tại __PRICE__","billing_frequency":"Tần suất thanh toán","business_perks":"Nhận thêm nhiều đặc quyền hơn nữa cho nhóm hoặc doanh nghiệp ở mọi quy mô và hình thức kinh doanh. Như giấy phép nâng cao, nhiều người dùng và nhiều đặc quyền khác.","cancel_anytime_no_contract":"Hủy bất cứ lúc nào","checkmarks_smb_ai_image_generator_subscription_1":"Toàn quyền truy cập vào công cụ AI kiến tạo cho nhóm của bạn","checkmarks_smb_ai_image_generator_subscription_2":"__CREDITS__ lần tạo mỗi tháng (1 lần tạo = 4 ảnh)","checkmarks_smb_ai_image_generator_subscription_3":"Chia sẻ số lần tạo trong nhóm","checkmarks_smb_ai_image_generator_subscription_4":"Sử dụng gói đăng ký 