,"ent:size":"Kích thước","ent:tip_no_access_content":"Tài khoản của bạn không có quyền truy cập nội dung này. Vui lòng liên hệ với Nhân viên quản lý tài khoản để biết thêm chi tiết.","ent:upgrade_your_license":"Vui lòng liên hệ với Nhân viên quản lý tài khoản để nâng cấp giấy phép của bạn","feature-collections:add_all":"Thêm tất cả","feature-collections:back_to_my_collections":"Quay lại bộ sưu tập của tôi","feature-collections:copy_to":"Sao chép đến...","feature-collections:number_in_parentheses":"(__NUMBER__)","feature-collections:set_as_cover":"Đặt làm ảnh bìa","feature-collections:view_only":"Chỉ xem","image:editorial_use_only":"Chỉ được phép sử dụng cho mục đích báo chí.","image:signed_model_and_property_release_on_file":"Giấy phép sử dụng ảnh người mẫu và tài sản lưu hồ sơ đã ký với Shutterstock, Inc.","image:signed_model_release_on_file":"Giấy phép sử dụng ảnh người mẫu lưu hồ sơ đã ký với Shutterstock, Inc.","image:signed_property_release_on_file":"Giấy phép sử dụng tài sản lưu hồ sơ đã ký với Shutterstock, Inc.","move_to_ellipsis":"Di chuyển đến...","search:actions-dropdown-more-text":"Thêm","site-header:collections":"Bộ sưu tập","site-header:video":"Video"},"freeTrialLandingPage":{"flex_10_bottom_banner_cta":"Dùng thử miễn phí ngay","flex_10_bottom_banner_message":"Bắt đầu bản dùng thử không rủi ro FLEX 10 và nhận mọi loại nội dung bạn cần.","flex_10_hero_banner_message_1":"Nhận 10 ảnh miễn phí hoặc kết hợp với video và nhạc.","flex_10_hero_banner_message_2":"Tha hồ tiết kiệm đến 70% sau khi kết thúc 1 tháng dùng thử.","flex_10_hero_banner_message_3":"Bạn sẽ không mất phí nếu hủy trong tháng đầu tiên. Sử dụng mã TRYFLEX10 khi thanh toán.","flex_10_pricing_card_product_description":"10 tín dụng/tháng - gói theo năm","flex_10_pricing_card_product_price_breakdown":"mỗi tín dụng","flex_10_pricing_card_subtitle":"Nhận 10 tín dụng mỗi tháng để mua ảnh, video hoặc nhạc bạn cần","flex_10_pricing_card_title":"Dùng thử gói FLEX 10 và nhận tối đa 10 lượt tải xuống","free_trial:download_images_for_free":"Tải xuống ảnh miễn phí","free_trial:explain_offerings":"Nhận nội dung và công cụ thiết kế dễ sử dụng có trong gói đăng ký hàng tháng của chúng tôi.","free_trial:first_month_free":"Miễn phí tháng đầu tiên nếu cam kết hàng năm","free_trial:high_quality_content":"Nội dung chất lượng cao để bạn bắt đầu xây dựng dự án.","free_trial_page_description":"Dùng thử Shutterstock ngay và nhận tối đa 10 lượt tải xuống. Bắt đầu và lưu ngay.","free_trial_page_title":"Dùng thử miễn phí, hủy bất cứ lúc nào - Shutterstock","image_10_bottom_banner_cta":"Bắt đầu dùng thử miễn phí","image_10_bottom_banner_message":"Tải ngay 10 ảnh MIỄN PHÍ với bản dùng thử không rủi ro.","image_10_hero_banner_message_1":"Dùng thử miễn phí gói 10 ảnh/tháng của Shutterstock.","image_10_hero_banner_message_2":"Bạn sẽ không mất phí nếu hủy trong tháng đầu tiên.","image_10_hero_banner_message_3":"Sử dụng mã PICK10FREE khi thanh toán.","image_10_hero_banner_title":"Nhận ngay 10 ảnh miễn phí.","image_10_pricing_card_product_description":"10 ảnh/tháng - gói theo năm","image_10_pricing_card_product_price_breakdown":"mỗi ảnh","image_10_pricing_card_subtitle":"Sau tháng đầu tiên:","image_10_pricing_card_title":"Dùng thử miễn phí 1 tháng, hủy bất cứ lúc nào","legal_copy":"Bạn có thể truy cập \u003cplansLink\u003etrang Gói đăng ký\u003c/plansLink\u003e để hủy trong thời hạn dùng thử miễn phí. Nếu bạn không hủy trong thời hạn dùng thử miễn phí, chúng tôi sẽ kích hoạt cam kết hàng năm và \u003cmoreInfoLink\u003ethu phí bạn hàng tháng\u003c/moreInfoLink\u003e. Nếu hủy sau thời hạn dùng thử miễn phí, bạn có thể phải chịu phí chấm dứt sớm. Gói đăng ký của bạn sẽ tự động gia hạn thêm 1 năm, trừ khi bạn \u003chelpLink\u003eliên hệ với chúng tôi\u003c/helpLink\u003e. Giới hạn một người 1 bản dùng thử. Chương trình khuyến mãi này không được kết hợp với bất kỳ ưu đãi, phiếu mua hàng hoặc chương trình giảm giá nào khác.","moustache_banner_cta":"Xem tất cả tùy chọn giá cước","moustache_banner_message":"Bạn cần thêm ảnh để dự án của mình thêm bùng nổ?","pricing_card_cta":"Bắt đầu dùng thử miễn phí"},"adpEditor":{"actions_apply":"Áp dụng","actions_crop":"Cắt xén","actions_revert":"Hoàn nguyên","common:actions_close":"Đóng","common:links_templates":"Mẫu","effects":"Hiệu ứng","facebook_ad":"Quảng cáo trên Facebook","file_name_edited":"dasua","filter_createblackandwhite":"Đen trắng","filter_original":"Gốc","filter_santorini":"Cổ điển","filter_sequoia":"Sequoia","filter_tranquil":"Tranquil","filter_tucson":"Ấm áp","freeform":"Hình tự do","more_filters_in_create":"Xem thêm bộ lọc trong Sáng tạo","more_sizes_in_create":"Xem thêm kích cỡ trong Sáng tạo","tiktok_post":"TikTok","try_more_editing_create":"Thử thêm công cụ chỉnh sửa trong Sáng tạo","width_height":"__WIDTH__:__HEIGHT__","workspaces:filter":"Bộ lọc"},"socialLinkAccount":{"account_type":"Tài khoản __CHANNEL__","add_account_sub_title":"Chọn mạng xã hội, sau đó cho phép Shutterstock truy cập vào tài khoản đó","add_account_title":"Thêm tài khoản vào Shutterstock","apps_connected_to_shutterstock":"Ứng dụng đã kết nối với Shutterstock","back":"Quay lại","channel_connected":"Đã kết nối __CHANNEL__","comment":"Bình luận","common:actions_cancel":"Hủy","connect":"Kết nối","connect_apps_to_shutterstock":"Kết nối ứng dụng với Shutterstock","connect_channel":"Kết nối __CHANNEL__","connect_instagram_via_facebook":"Kết nối Instagram qua Facebook","connect_it_to_fb_page":"Kết nối với một trang Facebook.","connect_via_facebook":"Kết nối qua Facebook.","connected":"Đã kết nối","connected_accounts":"Tài khoản đã kết nối","connected_accounts_description":"Kết nối tài khoản với Shutterstock sẽ giúp bạn đăng và truy xuất phân tích trực tiếp trên Shutterstock bằng những tài khoản đó. Nếu bạn muốn quản lý thông tin đăng nhập mạng xã hội, thông tin đó sẽ có tại mục hồ sơ trong tài khoản của bạn.","connected_to_shutterstock":"Đã kết nối với Shutterstock","convert_your_ig_account_to_igb":"Chuyển tài khoản Instagram của bạn thành tài khoản Instagram doanh nghiệp.","count_more":"Thêm __COUNT__","disconnect":"Ngắt kết nối","disconnect_confirmation_subtitle":"Việc xóa tài khoản sẽ dừng mọi thao tác đăng và thu thập dữ liệu trong tương lai.","disconnect_confirmation_title":"Bạn có chắc chắn muốn ngắt kết nối __CHANNEL__ không?","disconnected_from_shutterstock":"Đã ngắt kết nối __CHANNEL__ khỏi Shutterstock","done":"Xong","error":"Lỗi","facebook_preview_description":"Giả thiết cách hiển thị nội dung khi được đăng. Các cập nhật của mạng xã hội có thể ảnh hưởng đến kết quả hiển thị cuối cùng.","failed_to_publish":"Không thể đăng","instagram_business":"Instagram doanh nghiệp","instagram_size_limit":"Ảnh không đáp ứng giới hạn kích thước của Instagram để đăng. \u003cLearnMore\u003eTìm hiểu thêm\u003c/LearnMore\u003e","just_now":"Vừa xong","learn_more":"Tìm hiểu thêm","learn_more_link":"Tìm hiểu thêm","learn_more_message":"Giả thiết cách hiển thị nội dung khi được đăng. Các cập nhật của mạng xã hội có thể ảnh hưởng đến kết quả hiển thị cuối cùng.","lets_connect_your_account":"Hãy kết nối tài khoản của bạn","like":"Thích","login_to_facebook":"Đăng nhập vào Facebook","make_sure_igb_is_linked_to_fb_page":"Đảm bảo \u003cstrong\u003etài khoản Instagram doanh nghiệp\u003c/strong\u003e của bạn \u003cstrong\u003eđược liên kết với một trang Facebook\u003c/strong\u003e. \u003cLearnHow\u003eTìm hiểu cách làm\u003c/LearnHow\u003e","manage_account":"Quản lý tài khoản","manage_accounts":"Quản lý tài khoản","no_channel_account_connected":"Chưa kết nối tài khoản __CHANNEL__ nào","no_pages_error":"Không có trang nào trên tài khoản này.","no_pages_message":"Bạn phải có trang Facebook để kết nối. Sau khi tạo trang, bạn có thể kết nối tại đây.","page_connected":"Đã kết nối __PAGENAME__!","page_disconnected":"Đã ngắt kết nối __PAGENAME__","page_type":"trang __CHANNEL__","permissions_error_message":"Chúng tôi không có quyền cần thiết để đăng ảnh của bạn. Để thêm nhiều hơn, vui lòng kết nối lại tài khoản mạng xã hội của bạn.","publish":"Đăng","publish_add_social_account":"Thêm tài khoản mạng xã hội","publish_post_to":"Đăng lên","publish_select_social_account":"Chọn tài khoản mạng xã hội","publish_text":"Văn bản","published":"Đã đăng","re-sync":"Đồng bộ lại","return_to_channel_selection":"Quay lại mục Chọn kênh","return_to_publishing":"Quay lại mục Đăng","see_less":"Thu gọn","see_more":"Xem thêm","select_accounts":"Chọn tài khoản","select_all":"Chọn tất cả","select_business_accounts_you_want_to_connect":"Chọn tài khoản doanh nghiệp bạn muốn kết nối","select_channel_description":"Bạn có thể đăng lên mạng xã hội trực tiếp từ Shutterstock – bắt đầu bằng cách kết nối tài khoản của bạn.","select_pages_error":"Bạn chỉ được thêm một trang. {1} Nâng cấp để thêm nhiều hơn!","select_pages_you_want_to_connect":"Chọn trang bạn muốn kết nối","share":"Chia sẻ","social_publish_tos":"Bằng cách kết nối tài khoản, bạn đồng ý với \u003cTermsLink\u003eĐiều khoản sử dụng\u003c/TermsLink\u003e và \u003cLicenseLink\u003eThỏa thuận cấp phép\u003c/LicenseLink\u003e của chúng tôi.","terms_and_conditions":"Copy about connecting goes here","view_on_facebook":"Xem trên Facebook","view_on_instagram":"Xem trên Instagram"},"ecommImageSizeSelectItem":{"common:image_size_large":"Lớn","common:image_size_med":"Trung bình","common:image_size_medium":"Trung bình","common:image_size_small":"Nhỏ","common:image_size_vector":"Vector","dpi":"DPI","formats":"Định dạng","no_resolution_loss":"Điều chỉnh kích cỡ tùy ý mà vẫn giữ nguyên độ phân giải.","pixels":"pixel"},"dialog":{"common:actions_close":"Đóng","rewards:learn_more_modal_content":"\u003cpara\u003eChương trình khuyến mãi tặng thưởng của Shutterstock (\"Chương trình khuyến mãi\") sẽ áp dụng từ __START_DATE__ đến __END_DATE__ (\"Thời gian khuyến mãi\").\u003c/para\u003e\u003cpara\u003eĐể tham gia Chương trình khuyến mãi, người tham gia đủ điều kiện phải có cam kết hàng năm đang hoạt động, gói đăng ký Shutterstock Flex 10 được thanh toán hàng tháng hoặc gói đăng ký 10 ảnh mỗi tháng và thời hạn của gói đăng ký đó còn ít nhất 4 tháng khi bắt đầu Thời gian khuyến mãi (\"Gói đăng ký đủ điều kiện\").\u003c/para\u003e\u003cpara\u003eMỗi khi người tham gia đủ điều kiện tải xuống bảy (7) ảnh bằng Gói đăng ký đủ điều kiện trong Thời gian khuyến mãi, Shutterstock sẽ cung cấp (1) lượt tải xuống thuộc giấy phép tiêu chuẩn theo yêu cầu. Lượt tải xuống thuộc giấy phép tiêu chuẩn theo yêu cầu sẽ hết hạn sau một (1) năm kể từ ngày Shutterstock kích hoạt lượt tải xuống cho tài khoản của người dùng đủ điều kiện, kể cả khi Gói đăng ký đủ điều kiện đã hết hạn.\u003c/para\u003e\u003cpara\u003eChương trình khuyến mãi không áp dụng cho lượt tải xuống từ bất cứ gói đăng ký nào khác ngoài Gói đăng ký đủ điều kiện.\u003c/para\u003e","rewards:learn_more_modal_title":"Điều khoản chương trình khuyến mãi tặng thưởng của Shutterstock","rewards_opt_in_description":"Bạn đã đủ điều kiện nhận khuyến mãi cho 3 tháng sử dụng. Cứ \u003cstrong\u003e tải xuống 7 ảnh \u003c/strong\u003e là nhận một ảnh miễn phí để sử dụng trong vòng 1 năm!","rewards_opt_in_downloads_total":"__DOWNLOADS__/__TOTAL__","rewards_opt_in_learn_more":"Tìm hiểu thêm","rewards_opt_in_start":"Bắt đầu nhận ngay","rewards_opt_in_title":"Tải 7 ảnh, tặng 1 ảnh!"},"auth":{"10_premium_images":"Nhận 10 hình ảnh chất lượng cao với giá __PRICE__ ngay hôm nay","30_days_free":"30 ngày miễn phí, sau đó là __PRICE__/tháng – hủy bất cứ lúc nào trong thời hạn dùng thử","3andahalf_million_images":"Hơn 3,5 triệu ảnh mới được bổ sung hàng tháng","4andahalf_million_assets":"Hơn 4,5 triệu tài sản mới được bổ sung hàng tháng","650_million_assets":"Hơn 650 triệu ảnh chất lượng cao để thỏa sức lựa chọn và công cụ thiết kế dễ dùng","access_hd":"Truy cập video HD và nhạc bằng gói đăng ký của bạn","auth:login_form_left_panel_sub_text":"Kể câu chuyện của bạn bằng hình ảnh, video và âm nhạc lôi cuốn. Truy cập thư viện gồm hơn __VALUE__ triệu tài sản chất lượng cao của chúng tôi.","auth:login_form_log_in":"Đăng nhập","auth:login_form_marketing_title":"Biến ý tưởng thành hiện thực","auth:login_page_description":"Đăng nhập vào tài khoản Shutterstock của bạn để dễ dàng truy cập vào hàng triệu ảnh, vector, hình minh họa, video và âm nhạc có sẵn.","auth:login_page_title":"Đăng nhập hoặc Tạo tài khoản","cancel_risk_free":"Hủy không rủi ro trước khi hết thời hạn dùng thử","cancellation_terms":"Bạn có thể truy cập \u003cplansLink\u003etrang Gói đăng ký\u003c/plansLink\u003e để hủy trong thời hạn dùng thử miễn phí. Nếu bạn không hủy trong thời hạn dùng thử miễn phí, chúng tôi sẽ kích hoạt cam kết hàng năm và thu phí bạn hàng tháng. Nếu hủy sau thời hạn dùng thử miễn phí, bạn có thể phải trả phí hủy trước hạn. Gói đăng ký của bạn sẽ tự động gia hạn thêm 1 năm, trừ khi bạn \u003chelpLink\u003eliên hệ với chúng tôi\u003c/helpLink\u003e. Giới hạn 1 người 1 bản dùng thử. Chương trình khuyến mãi này không được kết hợp với bất kỳ ưu đãi, phiếu mua hàng hoặc chương trình giảm giá nào khác. Gói đăng ký của bạn sẽ tự động gia hạn thêm 1 năm, trừ khi bạn \u003chelpLink\u003eliên hệ với chúng tôi\u003c/helpLink\u003e. Giới hạn 1 người 1 bản dùng thử. Chương trình khuyến mãi này không được kết hợp với bất kỳ ưu đãi, phiếu mua hàng hoặc chương trình giảm giá nào khác.","create_an_account":"Tạo tài khoản","create_free_account":"Tạo tài khoản miễn phí để xem ảnh của bạn","create_user_trial_flex10_get_images_music_title":"Nhận miễn phí ảnh và nhạc trong 1 tháng","create_user_trial_image10_title":"1 tháng dùng thử Shutterstock miễn phí","donwload_10_premium_images":"Tải xuống 10 hình ảnh chất lượng cao trong 30 ngày dùng thử miễn phí","full_access":"\u003cb\u003eQuyền truy cập đầy đủ:\u003c/b\u003e Trải nghiệm toàn bộ thư viện gồm hơn 450 triệu hình ảnh, hình minh họa và vector của chúng tôi.","full_access_alt":"\u003cb\u003eQuyền truy cập đầy đủ:\u003c/b\u003e Truy cập vào hơn 475 triệu tài sản cùng nhiều công cụ thiết kế, công cụ phân tích sáng tạo và trình lập kế hoạch nội dung mới.","generate:auth_modal_subtitle":"Đăng nhập hoặc đăng ký để tạo và tinh chỉnh hình ảnh __TERM__ từ AI bằng cách sử dụng Trình tạo ảnh bằng trí tuệ nhân tạo của chúng tôi.","generate:auth_modal_title":"Thổi hồn cho __TERM__","generate:create_free_account":"Tạo tài khoản miễn phí","generate:enjoy_creative_ai_tools":"Hưởng quyền truy cập vào tính năng AI sáng tạo của chúng tôi.","generate:ethical_ai_model_support":"Chúng tôi là đơn vị đầu tiên hỗ trợ mô hình kiến tạo chuẩn mực bằng AI, trả công xứng đáng cho những nghệ sĩ đóng góp.","generate:fresh_ai_images":"Ảnh mới do trí tuệ nhân tạo xây dựng","generate:genai_signup_subtext_1":"Truy cập những mô hình AI tốt nhất và mới nhất của Runway, Google, OpenAI, v.v.","generate:genai_signup_subtext_2":"Bắt đầu bằng câu lệnh, thêm ảnh tham khảo hoặc sử dụng tính năng chỉnh sửa bằng AI để hiện thực hóa tầm nhìn của bạn.","generate:genai_login_left_panel_title":"Your edit is waiting.","generate:genai_login_left_panel_description":"Sign up and pick up where you left off.","generate:generate_using_dalle3":"Tạo ảnh chất lượng cao bằng DALL·E 3.","generate:high_quality_license_image":"An tâm cấp phép ảnh từ AI! Mọi tài sản đều được tạo bằng những hình ảnh chất lượng cao đã cấp phép.","generate:powering_the_future":"Chúng tôi đang đi đúng hướng để mở đường cho tương lai của trí tuệ nhân tạo.","generate:promote_ethical_image_result":"Chúng tôi tăng cường cung cấp kết quả hình ảnh hoàn thiện và chuẩn mực.","generate:support_artists":"Hỗ trợ nghệ sĩ bằng cách sử dụng mô hình kiến tạo chuẩn mực bằng AI, trả công xứng đáng cho những nghệ sĩ đóng góp.","generate:unleash_your_creativity":"Bật tung sáng tạo với sức mạnh của AI","generate_ai_images":"Tạo hàng trăm ảnh từ AI","get_10_free_images":"Nhận 10 ảnh Shutterstock miễn phí","get_content_for_1_month":"Nhận miễn phí ảnh, video và nhạc trong 1 tháng","keep_track_history":"Dễ dàng theo dõi lịch sử tải xuống và duyệt xem","keep_what_you_have_licensed":"\u003cb\u003eLưu giữ những nội dung đã cấp phép:\u003c/b\u003e Bạn vẫn có thể lưu giữ nội dung đã tải xuống kể cả khi đã hủy đăng ký.","keep_what_you_have_licensed_alt":"\u003cb\u003eLưu giữ những nội dung đã cấp phép:\u003c/b\u003e Bạn vẫn có thể lưu giữ ảnh đã tải xuống kể cả khi hủy đăng ký.","login_or_signup":"Đăng nhập hoặc đăng ký","login_to_shutterstock":"Đăng nhập vào Shutterstock","number_million_of_our_best":"Hơn 80 triệu ảnh, video và âm nhạc tốt nhất của chúng tôi","offer_not_available_in_india":"Ưu đãi không áp dụng tại Ấn Độ","plus_much_more":"Và còn nhiều hơn thế.","risk_free":"\u003cb\u003eKhông rủi ro:\u003c/b\u003e Hủy bất cứ lúc nào trong tháng đầu tiên chỉ bằng vài cú nhấp và không phải trả phí.","save_designs_re_edit_later":"Lưu thiết kế để bạn có thể chỉnh sửa lại sau ","save_favorite_assets":"Lưu tài sản yêu thích của bạn trong Bộ sưu tập và chia sẻ miễn phí với mọi người","save_more":"\u003cb\u003eTiết kiệm thêm:\u003c/b\u003e Sử dụng tháng đầu tiên miễn phí, sau đó hưởng mức giá chỉ __PRICE__/tháng cho gói đăng ký hàng năm.","save_sort_collection":"Lưu và sắp xếp những tài sản yêu thích với Bộ sưu tập","share_collections":"Chia sẻ Bộ sưu tập với bất kỳ ai ở bất cứ đâu","signup_modal_access_exclusive_features":"Truy cập các tính năng độc quyền bằng tài khoản miễn phí","site-header:sign_up":"Đăng ký","try_ai_generator":"Dùng thử Trình tạo ảnh bằng AI và tạo ra hình ảnh của riêng bạn","try_before_purchase":"Dùng thử nội dung miễn phí và có thể tải xuống trước khi mua","try_before_you_buy":"Thử nội dung dùng thử miễn phí có thể tải xuống trước khi mua","try_shutterstock_free":"Dùng thử Shutterstock miễn phí","unlimited_access":"Nhận quyền truy cập không giới hạn vào nền tảng thiết kế và chỉnh sửa dễ sử dụng do AI hỗ trợ","unlimited_ai_generations":"100 lần tạo bằng AI mỗi tháng","unlimited_ai_models":"Truy cập vào nhiều mô hình AI hàng đầu từ Google, OpenAI, Runway, v.v.","unlimited_signup_checkmark_royalty_free":"Lượt tải xuống miễn phí bản quyền không giới hạn","unlimited_signup_checkmark_single_seat":"Một người dùng","unlimited_signup_checkmark_standard_license":"Giấy phép tiêu chuẩn để sử dụng cho kỹ thuật số và in ấn sáng tạo","unlimited_signup_header":"Không giới hạn lượt tải xuống. Nội dung tuyệt đỉnh. Đáp ứng mọi nhu cầu sáng tạo.","unlimited_signup_sub_header":"Ảnh, video, nhạc, v.v. Tải xuống bằng quyền truy cập không giới hạn.","unlimited_tiers_images_signup_header":"Nội dung đáng kinh ngạc. Không giới hạn lượt tải xuống. Giá tốt không đối thủ.","unlimited_tiers_images_signup_sub_header":"Tải tất cả ảnh bạn cần bất cứ lúc nào."},"priceFormatter":{"comp_credits":"__PRICE__ tín dụng nội dung dùng thử","credit":"__PRICE__ tín dụng","credits":"__PRICE__ tín dụng","ent:unavailable":"Không sẵn dùng","ent:unlimited":"Không giới hạn","license_credits":"__PRICE__ tín dụng giấy phép"},"notifications":{"notifications:cancellable_error_message":"Đã xảy ra lỗi khi hủy đăng ký của bạn. Vui lòng thử lại.","notifications:contact_team_admin_error_message":"Liên hệ với quản trị viên nhóm của bạn để mua","notifications:email_updated":"E-mail của bạn đã được cập nhật.","notifications:label_auto_refill_success_off":"Đã tắt tự động nạp lại.","notifications:label_auto_refill_success_on":"Đã bật tự động nạp lại.","notifications:label_auto_renew_success_off":"Đã tắt tự động gia hạn.","notifications:label_auto_renew_success_off_rebrand":"Bạn đã tắt thành công tính năng tự động gia hạn.","notifications:label_auto_renew_success_on":"Đã bật tự động gia hạn.","notifications:label_auto_renew_success_on_rebrand":"Bạn đã bật thành công tính năng tự động gia hạn.","notifications:label_generic_failure":"Đã xảy ra lỗi. Vui lòng thử lại.","notifications:password_updated":"Mật khẩu của bạn đã được cập nhật.","notifications:profile_name_updated":"Tên hồ sơ của bạn đã được cập nhật.","notifications:rebrand_subscription_cancellation_success_message":"Bạn đã hủy gói đăng ký thành công.","notifications:settings_updated":"Cài đặt tài khoản đã được cập nhật.","notifications:subscription_cancellation_success_message":"Đã hủy gói đăng ký của bạn thành công"},"pricingDynamic":{"access_high_quality_assets_and_easy_design_tools_new_assets_added_daily":"Truy cập hơn 475 triệu tài sản chất lượng cao và công cụ thiết kế dễ sử dụng. 200.000 tài sản mới được bổ sung mỗi ngày!","ai_generated_images":"Ảnh do trí tuệ nhân tạo xây dựng","any_budget":"Ngân sách bất kỳ","audience:business":"Kinh doanh","brands_that_help_power_our_content":"Những thương hiệu góp phần làm giàu nội dung của chúng tôi.","common:actions_close":"Đóng","common:links_design_tools":"Công cụ thiết kế","common:links_editorial":"Báo chí","common:links_templates":"Mẫu","developers:docs_menu_item_shutterstock_ui_licensing":"Xin cấp phép","enhanced_license":"Giấy phép nâng cao","ent:license_enhanced":"Giấy phép nâng cao","ent:license_standard":"Giấy phép tiêu chuẩn","enterprise":"Enterprise","essential_music_license_1":"Truy cập các bài nhạc PremiumBeat \u003cpbLogo /\u003e","feature-support:call_us":"Gọi cho chúng tôi","feature-support:email_us":"Gửi e-mail cho chúng tôi","feature_matrix:ability_to_store_content_on_company_dam_api_integration_saml_based_single_sign_on":"Khả năng lưu trữ nội dung trên công cụ DAM của công ty, Tích hợp API, Đăng nhập một lần bằng SAML","feature_matrix:access_to_content_research_access_to_unwatermarked_previews_to_download":"Tiếp cận các nghiên cứu về nội dung, Truy cập để tải xuống bản xem trước không có dấu bản quyền","feature_matrix:ad_spend_less":"Chi tiêu quảng cáo dưới 5.000 USD","feature_matrix:add_on_available":"Tiện ích sẵn có","feature_matrix:additional_features":"Tính năng bổ sung","feature_matrix:advertising":"Quảng cáo","feature_matrix:ai":"AI","feature_matrix:ai_powered_predictive_performance_scoring":"Điểm số về mức độ tương tác do AI dự đoán, nghiên cứu và nội dung tạo do AI tuyển chọn, Quyền sử dụng độc quyền nội dung AI","feature_matrix:animations":"Hiệu ứng động","feature_matrix:apps_games_dvd":"Ứng dụng, trò chơi và DVD","feature_matrix:basic_image_editing_tooltip":"Cắt xén, chèn văn bản, lọc và nhiều tính năng hơn thế nữa.","feature_matrix:corporate_videos_personal_use":"Mục đích sử dụng cá nhân và video công ty","feature_matrix:creative_ai_editing_tools":"Công cụ chỉnh sửa AI sáng tạo","feature_matrix:creative_ai_editing_tools_tooltip":"Cọ ma thuật, Mở rộng ảnh, Biến tấu và Trình xóa nền. \u003ca\u003eNhấp vào đây\u003c/a\u003e để xem thêm thông tin.","feature_matrix:enhanced":"Nâng cao","feature_matrix:enhanced_license_tooltip":"Giấy phép nâng cao đem lại nhiều quyền sử dụng hơn để bạn có thể dùng ảnh trong buôn bán hàng hóa, mẫu web, mẫu in và môi trường thương mại. \u003cbutton\u003eXem thêm thông tin\u003cbutton\u003e","feature_matrix:film_and_theatrical":"Sân khấu và điện ảnh","feature_matrix:free_or_revenue_generating":"Miễn phí hoặc tạo ra doanh thu","feature_matrix:free_or_revenue_generating_ads":"Miễn phí hoặc tạo ra doanh thu (bao gồm doanh thu từ lượt mua và quảng cáo trong ứng dụng)","feature_matrix:generate_ai_images":"Tạo ảnh từ AI","feature_matrix:generate_ai_images_tooltip":"Tạo nên những hình ảnh tuyệt đẹp ngay tức thì với Trình tạo ảnh bằng AI của chúng tôi","feature_matrix:industry_based_creative_insights":"Thông tin sáng tạo dựa theo ngành","feature_matrix:industry_events_in_store_display":"Bao gồm sự kiện công nghiệp, triển lãm thương mại và điểm trưng bày tại cửa hàng","feature_matrix:industry_point_of_sale":"Công nghiệp và điểm bán hàng","feature_matrix:movies_live_performances":"Phim, kịch và biểu diễn trực tiếp","feature_matrix:online_streaming":"Phát trực tuyến (YouTube và Vimeo)","feature_matrix:online_wedding_corporate":"Trực tuyến, đám cưới và công ty","feature_matrix:pilots_public_broadcasting":"Phát sóng công cộng và tập mở đầu","feature_matrix:podcasts":"Podcast","feature_matrix:premium_image_editing_tooltip":"Tất cả công cụ chỉnh sửa ảnh cơ bản + xóa nền hoặc thay đổi kích cỡ thông minh cho mọi ảnh, kể cả ảnh do bạn tải lên.","feature_matrix:search_and_download_ai_generated_images":"Tìm kiếm và tải xuống \u003cdashed\u003eảnh tạo bằng AI\u003cdashed\u003e","feature_matrix:search_and_download_ai_generated_images_tooltip":"Ảnh do trí tuệ nhân tạo xây dựng là nội dung mới được tạo bởi công nghệ trí tuệ nhân tạo vốn đã tích lũy hàng triệu tài sản, mô tả và từ khóa của nội dung thực. Khi người dùng tạo ảnh bằng trình tạo của chúng tôi, ảnh đó sẽ được thêm vào thư viện ảnh để tất cả mọi người cùng sử dụng!","feature_matrix:series_films_talk_shows":"Phim bộ, phim, tin tức, giải trí và chương trình phỏng vấn","feature_matrix:single_territory":"Lãnh thổ duy nhất","feature_matrix:standard":"Tiêu chuẩn","feature_matrix:standard_license_tooltip":"Giấy phép tiêu chuẩn phù hợp với phần lớn các nhu cầu sử dụng và sáng tạo. \u003cbutton\u003eXem thêm thông tin\u003cbutton\u003e","feature_matrix:student_project_only":"Chỉ dành cho dự án của sinh viên","feature_matrix:transfer_license_ownership":"Chuyển nhượng quyền sở hữu giấy phép, Giấy phép theo yêu cầu và bảo vệ pháp lý không giới hạn, Quyền sử dụng cho mục đích nhạy cảm, Quyền thương mại đối với tài sản báo chí","feature_matrix:tv_and_radio":"TV và radio","feature_matrix:up_to_copies_downloads":"Lên tới 1000 bản hoặc lượt tải xuống","feature_matrix:upgrade_available":"Upgrade available","feature_matrix:web":"Web","feature_matrix:websites_social_media":"Trang web, phương tiện truyền thông xã hội (bao gồm Facebook, Twitter, Instagram, TikTok, Twitch)","for_businesses":"Dành cho doanh nghiệp","for_individuals":"Dành cho cá nhân","genai":"GenAI","get_started":"Bắt đầu","get_the_ideal_pricing_plan_for_your_projects":"Chọn gói giá cước lý tưởng nhất cho dự án của bạn","guide_to_our_plans":"Hướng dẫn đơn giản về các gói đăng ký của chúng tôi","help_card_call_description":"Số điện thoại địa phương của bạn: 1-646-419-4452","help_card_call_title":"Gọi cho chúng tôi","help_card_contact_us_description":"Đội ngũ của chúng tôi sẽ giải đáp mọi thắc mắc của bạn.","help_card_faq_button_title":"Xem câu hỏi thường gặp","help_card_faq_description":"Khám phá mục câu hỏi thường gặp của chúng tôi.","help_card_faq_title":"Câu hỏi thường gặp","help_card_message_description":"Chúng tôi sẽ liên hệ lại với bạn","help_card_message_title":"Gửi tin nhắn cho chúng tôi","help_cards_title":"Bạn vẫn còn thắc mắc? Chúng tôi luôn sẵn sàng hỗ trợ.","image-pricing:faq_button":"Xem tất cả","image-pricing:faq_title":"Câu hỏi thường gặp","image_grid_title":"Thư viện nội dung lớn nhất thế giới với hơn 500 triệu tài sản","image_grid_title_unlimited":"Thỏa mãn tầm nhìn sáng tạo của bạn với thư viện nội dung lớn nhất thế giới","legal_indemnification":"Bồi thường pháp lý","limited":"Có hạn","merchandising_and_packaging":"Hàng hóa và bao bì","music_license_common_1":"Truy cập Âm nhạc Shutterstock \u003csstkLogo /\u003e","music_license_common_2":"Truy cập nhạc nền (Hiệu ứng âm thanh) \u003csoundEffectsLogo /\u003e","need_a_more_flexible_plan":"Bạn cần gói đăng ký hoặc tùy chọn thanh toán linh hoạt hơn? Chúng tôi cung cấp gói đăng ký đáp ứng mọi nhu cầu và mọi công ty. \u003ca\u003eLiên hệ với chúng tôi\u003c/a\u003e","number_of_team_members":"Số lượng thành viên nhóm","out_of_home_advertising_impressions":"Bản in quảng cáo ngoài trời","over_20m_images_every_day_from_editorial_photographers":"Hơn 20.000 ảnh mới mỗi ngày từ các nhiếp ảnh gia báo chí và đối tác toàn cầu của chúng tôi.","packs":"Gói","premium_music_license_1":"Truy cập 14 nghìn bài nhạc PremiumBeat \u003cpbLogo /\u003e","premium_music_license_2":"Phân biệt bài nhạc Shutterstock \u003csstkLogo /\u003e với bài nhạc PremiumBeat \u003cpbLogo /\u003e bằng logo hiển thị trước tiêu đề bài nhạc.","pricing:enhanced_video_license":"Giấy phép video nâng cao","pricing:license_dialog_footer_talk_to_us_business_solutions_link":"Để biết thêm về bảo vệ pháp lý và quyền chuyển nhượng, \u003ca href=\"__BUSINESS_SOLUTION_LINK__\" target=\"_blank\"\u003ehãy trao đổi cùng chúng tôi về các giải pháp kinh doanh\u003c/a\u003e.","pricing:license_dialog_footer_talk_to_us_enterprise_link":"Để biết thêm về bảo vệ pháp lý và quyền chuyển nhượng, \u003ca href=\"__ENTERPRISE_LINK__\" target=\"_blank\"\u003ehãy trao đổi cùng chúng tôi về Enterprise\u003c/a\u003e.","pricing:license_dialog_footer_terms_of_service":"Để xem đầy đủ thông tin chi tiết về các loại giấy phép và các tính năng có trong giấy phép, vui lòng xem \u003ca href=\"__TOS_LINK__\" target=\"_blank\"\u003eĐiều khoản dịch vụ\u003c/a\u003e của chúng tôi.","pricing:standard_video_license":"Giấy phép video tiêu chuẩn","pricing_business_feature_matrix:limited":"có hạn","pricing_business_feature_matrix:select_plans":"chọn gói đăng ký","pricing_business_feature_matrix:select_plans_tooltip":"Tính năng xin cấp phép nâng cao có trong gói đăng ký Flex.","pricing_business_page:additional_features_ability_to_store_name":"Khả năng lưu trữ nội dung trên công cụ DAM của công ty","pricing_business_page:additional_features_api_integration_name":"Tích hợp API và đăng nhập một lần bằng SAML","pricing_business_page:additional_features_limited_tooltip":"Quyền truy cập vào nội dung được lưu trữ trên công cụ DAM của công ty chỉ dành cho thành viên nhóm đã thêm.","pricing_business_page:for_business_tooltip":"Gói đăng ký doanh nghiệp của chúng tôi phù hợp với đội nhóm có nhiều nhà sáng tạo trong một dự án. Toàn bộ nhóm của bạn có thể truy cập và chỉnh sửa nội dung trong một tài khoản.","pricing_business_page:for_individuals_tooltip":"Gói đăng ký một người dùng của chúng tôi phù hợp với người làm việc tự do và chủ doanh nghiệp muốn tạo tài liệu cho riêng mình.","pricing_business_page:licensing_business_level_name":"Tính năng xin cấp phép cấp doanh nghiệp cho phép nhiều thành viên tải xuống, lưu trữ, chia sẻ và chỉnh sửa tài sản.","pricing_business_page:licensing_business_level_tooltip":"Mọi thành viên nhóm đã thêm đều có thể xin cấp phép trên tư cách doanh nghiệp thay vì cá nhân.","pricing_card_contact_us":"Liên hệ với chúng tôi","pricing_card_essential":"Essential (4K, HD, SD)","pricing_card_premium":"Cao cấp","pricing_faq:annual_plan_cancellation_answer":"Bạn có thể hủy gói đăng ký hằng năm, thanh toán theo tháng trước khi kết thúc thời hạn hợp đồng nhưng sẽ phải trả 50% chi phí đăng ký còn lại, trừ khi luật pháp địa phương yêu cầu chúng tôi cung cấp cho bạn phương án hủy và nhận tiền hoàn lại. Nếu gói đăng ký được đặt thành tự động gia hạn, bạn có thể tắt tính năng này bất cứ lúc nào trong phần cài đặt tài khoản để đảm bảo gói đăng ký không bị gia hạn khi kết thúc thời hạn hợp đồng. Tìm hiểu thêm về việc hủy đăng ký \u003ca href=\"__HELP_LINK__\" target=\"_blank\"\u003etại đây\u003c/a\u003e.","pricing_faq:any_way_to_use_editorial_commercially_answer":"Trong một số trường hợp, Shutterstock có thể làm việc với người đóng góp và người nắm quyền để có được quyền sử dụng cho mục đích thương mại trong các trường hợp nhất định. Trong một số trường hợp nhất định, Shutterstock sẽ cung cấp Asset Assurance™. Bên cạnh giấy phép thương mại, dịch vụ này còn cung cấp các khoản bồi thường bổ sung cho những trường hợp sử dụng ảnh báo chí trong chiến dịch cụ thể. Asset Assurance™ do Shutterstock đánh giá và phê duyệt về mặt pháp lý. Bạn có thể tìm hiểu thêm \u003ca href=\"__HELP_LINK__\" target=\"_blank\"\u003etại đây\u003c/a\u003e.","pricing_faq:any_way_to_use_editorial_commercially_question":"Có cách nào để sử dụng ảnh báo chí cho mục đích thương mại không?","pricing_faq:differences_between_individual_and_team_account_answer":"Với tài khoản cá nhân, chỉ bạn mới có thể truy cập để xin cấp phép, tải xuống và sử dụng nội dung. Nếu bạn làm việc theo nhóm hoặc trong môi trường công ty, gói đăng ký theo nhóm hoặc tài khoản Enterprise sẽ là lựa chọn phù hợp nhất với bạn. Vui lòng \u003ccontactUsLink\u003eliên hệ với chúng tôi\u003c/contactUsLink\u003e, chúng tôi rất sẵn lòng hỗ trợ bạn tìm ra gói đăng ký phù hợp.","pricing_faq:differences_between_individual_and_team_account_answer_new":"Với tài khoản cá nhân, chỉ bạn mới có thể truy cập để xin cấp phép, tải xuống và sử dụng nội dung. Nếu bạn làm việc theo nhóm hoặc trong môi trường công ty, gói đăng ký theo nhóm hoặc tài khoản Enterprise sẽ là lựa chọn phù hợp nhất với bạn. Vui lòng \u003ca href=\"__CONTACT_US_LINK__\" target=\"_blank\"\u003eliên hệ với chúng tôi\u003c/a\u003e, chúng tôi rất sẵn lòng hỗ trợ bạn tìm ra gói đăng ký phù hợp.","pricing_faq:differences_between_individual_and_team_account_question":"Tài khoản cá nhân, tài khoản nhóm và tài khoản Enterprise có gì khác nhau?","pricing_faq:do_on_demand_or_monthly_downloads_expire_answer":"Lượt tải xuống của gói theo yêu cầu có hiệu lực trong vòng 12 tháng kể từ ngày mua. Lượt tải xuống của gói đăng ký chỉ sử dụng được trong tháng và không được chuyển sang tháng tiếp theo.","pricing_faq:do_on_demand_or_monthly_downloads_expire_question":"Lượt tải xuống hằng tháng hoặc gói theo yêu cầu có hết hạn không?","pricing_faq:do_you_provide_automated_billing_answer":"Tính năng tự động gia hạn của Shutterstock là tùy chọn thanh toán tự động, cho phép bạn sử dụng dịch vụ liên tục bằng cách tự động gia hạn gói đăng ký hiện tại của bạn. Gói đăng ký sẽ gia hạn 12 giờ trước khi bắt đầu phân bổ lượt tải xuống tiếp theo của bạn. Tính năng này sẽ mặc định được bật cho tất cả các gói đăng ký, từ đó cung cấp cho khách hàng quyền truy cập vào các lượt tải xuống đơn giản bất cứ khi nào họ muốn, đồng thời có thể dễ dàng quản lý trong cài đặt tài khoản.\n   \u003cautoRenewalArticleLink\u003eĐọc thêm về tự động gia hạn.\u003c/autoRenewalArticleLink\u003e \n  Gói theo yêu cầu được thiết kế để tự động nạp lại khi dùng hết. Khi tải xuống ảnh hoặc video clip cuối cùng từ một gói, số lượt tải xuống ban đầu sẽ được tự động bổ sung và bạn sẽ bị thu phí qua phương thức thanh toán lưu hồ sơ.","pricing_faq:do_you_provide_automated_billing_question":"Bạn có cung cấp tính năng thanh toán tự động không?","pricing_faq:editorial_use_only_available_licenses_answer":"Nội dung \"Chỉ được phép sử dụng cho mục đích báo chí\" của Shutterstock có hai loại giấy phép khác nhau: Tiêu chuẩn và Báo chí. Bạn có thể mua nội dung có trong Giấy phép tiêu chuẩn, gồm quyền sử dụng trên web và mạng xã hội cho lượng khán giả hạn chế, bằng gói đăng ký và gói theo yêu cầu, hoặc chọn mua trên \u003cvideoPricingLink\u003etrang giá cước video\u003c/videoPricingLink\u003e. Nội dung báo chí do các nhiếp ảnh gia báo chí và đối tác toàn cầu của chúng tôi sản xuất chỉ có trong Giấy phép báo chí, bao gồm quyền sử dụng kỹ thuật số duy nhất và có thể mua dưới dạng một clip hoặc một gói 25 clip.","pricing_faq:editorial_use_only_available_licenses_question":"Có những giấy phép nào dành cho nội dung \"Chỉ được phép sử dụng cho mục đích báo chí\"?","pricing_faq:have_other_question":"Bạn có thắc mắc khác? \u003ccontactUsLink\u003eLiên hệ với chúng tôi\u003c/contactUsLink\u003e","pricing_faq:how_can_editorial_be_used_answer":"Có thể sử dụng nội dung báo chí trên các sản phẩm in ấn hoặc kỹ thuật số:\u003cbr /\u003e\u003cul\u003e\u003cli\u003eBài báo tin tức\u003c/li\u003e\u003cli\u003eNội dung bên trong sách phi hư cấu\u003c/li\u003e\u003cli\u003ePhim tài liệu\u003c/li\u003e\u003cli\u003eCác mục đích mang tính thời sự khác\u003c/li\u003e\u003c/ul\u003e\u003cbr /\u003eKhông được sử dụng nội dung báo chí trong:\u003cul\u003e\u003cli\u003eTrang bìa ấn phẩm\u003c/li\u003e\u003cli\u003eTruyền hình phát sóng hoặc chương trình trên nền tảng Internet (OTT), chẳng hạn như Netflix\u003c/li\u003e\u003cli\u003eQuảng cáo\u003c/li\u003e\u003cli\u003eHàng hóa\u003c/li\u003e\u003cli\u003eBao bì sản phẩm\u003c/li\u003e\u003cli\u003eBất kỳ mục đích thương mại/quảng bá nào khác\u003c/li\u003e\u003c/ul\u003e","pricing_faq:how_can_editorial_be_used_question":"Nội dung báo chí có thể được sử dụng như thế nào?","pricing_faq:how_can_i_use_editorial_answer":"Nội dung \"Chỉ được phép sử dụng cho mục đích báo chí\" không dành cho mục đích thương mại. Không có ngoại lệ đối với chế tài này, do đó, ngay cả các tổ chức tôn giáo, giáo dục và phi lợi nhuận cũng phải tuân thủ hướng dẫn quan trọng này.\n\nMột số cách phổ biến để sử dụng nội dung báo chí được phép bao gồm:\n- bản tin, lưu trữ và ấn phẩm \n- phim tài liệu \n- sách phi hư cấu\n- nội dung dịch vụ công cộng\n\nMột số trường hợp sử dụng trái phép Nội dung báo chí:\n- bài viết quảng cáo và đồ họa quảng cáo (bao gồm \"bài báo thương mại\")\n- sản phẩm thương mại\n- bao bì sản phẩm\n- quảng cáo\n- hàng hóa\n- chiến dịch truyền thông xã hội\n","pricing_faq:how_can_i_use_editorial_question":"Làm thế nào để sử dụng Nội dung báo chí?","pricing_faq:how_do_image_subs_work_answer":"Các gói đăng ký của chúng tôi mang đến ưu đãi tốt nhất về ảnh thuộc Giấy phép tiêu chuẩn và cung cấp cho bạn quyền truy cập vào toàn bộ thư viện hình ảnh, vector và hình minh họa miễn phí bản quyền có độ phân giải cao. Sau khi đăng ký gói đăng ký, bạn sẽ được phân bổ một số lượng lượt tải xuống hằng tháng và con số này sẽ được đặt lại vào đầu mỗi tháng. Gói của bạn sẽ hết hạn khi kết thúc cam kết 12 tháng.","pricing_faq:how_do_image_subs_work_answer_new":"Các gói đăng ký của chúng tôi mang đến ưu đãi tốt nhất về ảnh, video hoặc bài nhạc thuộc Giấy phép tiêu chuẩn và cung cấp cho bạn quyền truy cập vào toàn bộ thư viện nội dung miễn phí bản quyền. Sau khi đăng ký một gói đăng ký, bạn sẽ được phân bổ một số lượng lượt tải xuống hằng tháng và con số này sẽ được đặt lại vào đầu mỗi tháng. Gói đăng ký nhạc không giới hạn đi kèm lượt tải xuống không giới hạn, nhưng vì lý do bảo mật, chúng tôi sẽ giới hạn lượt tải xuống mỗi ngày ở mức 40 bài nhạc. Gói của bạn sẽ hết hạn khi kết thúc cam kết 12 tháng. Tìm hiểu thêm về cách chúng tôi thiết kế các gói đăng ký \u003ca href=\"__HELP_LINK__\" target=\"_blank\"\u003etại đây\u003c/a\u003e.","pricing_faq:how_do_image_subs_work_question":"Gói đăng ký Shutterstock hoạt động như thế nào?","pricing_faq:how_do_music_subs_work_answer":"Gói đăng ký âm nhạc của chúng tôi cấp cho bạn quyền truy cập không giới hạn vào bộ sưu tập nhạc với Giấy phép tiêu chuẩn, tuy nhiên số lượt tải xuống hàng ngày bị giới hạn ở mức 40 bài vì lý do bảo mật. Gói đăng ký Essential cho phép bạn truy cập vào bộ sưu tập các bài nhạc và hiệu ứng âm thanh đa dạng của Shutterstock. Cùng với thư viện âm nhạc và hiệu ứng âm thanh của Shutterstock, gói đăng ký Premium của chúng tôi còn cấp cho bạn quyền truy cập vào 14 nghìn bài nhạc PremiumBeat khác. Bạn có thể dễ dàng phân biệt bài nhạc Shutterstock với bài nhạc PremiumBeat bằng logo hiển thị trước tiêu đề bài nhạc.","pricing_faq:how_do_music_subs_work_question":"Gói đăng ký nhạc Shutterstock hoạt động như thế nào?","pricing_faq:how_do_video_subs_work_answer":"Gói đăng ký của chúng tôi cung cấp ưu đãi tốt nhất về video và bao gồm quyền truy cập vào thư viện clip HD và 4K (Không bao gồm clip Select và thành phần).\nVới gói đăng ký hằng tháng (không có hợp đồng), bạn có thể tải xuống số lượng clip đi kèm với gói đăng ký bạn đã chọn trong thời gian một tháng. Vào cuối tháng, gói đăng ký cùng với mọi lượt tải xuống chưa sử dụng của bạn sẽ hết hạn.","pricing_faq:how_do_video_subs_work_question":"Gói đăng ký Shutterstock hoạt động như thế nào?","pricing_faq:how_to_find_editorial_content_answer":"Shutterstock cũng sở hữu một bộ sưu tập nội dung báo chí phong phú và được cập nhật liên tục, đi kèm với \u003ca href=\"__HELP_LINK__\" target=\"_blank\"\u003eGiấy phép báo chí\u003c/a\u003e riêng. Nội dung này được định giá riêng; bạn có thể mua lẻ từng ảnh hoặc gói 25 ảnh, còn video thì được cung cấp dưới dạng từng lượt tải xuống đơn lẻ. Bạn có thể tìm kiếm bộ sưu tập ảnh và clip cao cấp của chúng tôi bằng cách chọn tùy chọn Báo chí trong menu thả xuống danh mục nội dung trên thanh tìm kiếm.\u003cbr /\u003eBạn cũng có thể truy cập nội dung này qua tab Báo chí trên thanh điều hướng trên cùng. Tại đây, bạn còn có thể duyệt xem nhiều danh mục phổ biến, bao gồm giải trí, tin tức, hoàng gia và thể thao.","pricing_faq:how_to_find_editorial_content_question":"Làm thế nào để tìm nội dung báo chí?","pricing_faq:how_to_license_editorial_content_answer":"Nhận quyền truy cập vào ảnh Shutterstock Editorial bằng cách mua lẻ một lượt tải xuống hoặc gói 25 ảnh. Chúng tôi cũng cung cấp video clip lẻ với Giấy phép báo chí; chỉ cần nhấp vào nút \"Thêm vào giỏ hàng\" khi xem clip để bắt đầu. Xin lưu ý rằng do những hạn chế cụ thể, một số nội dung trong Bộ sưu tập báo chí của chúng tôi không có sẵn tại tất cả các khu vực.","pricing_faq:how_to_license_editorial_content_question":"Làm thế nào để xin cấp phép nội dung Shutterstock Editorial?","pricing_faq:how_to_license_editorial_image_answer":"Ảnh và video của Shutterstock Editorial được các nhiếp ảnh gia báo chí và đối tác toàn cầu của chúng tôi sản xuất. Nhận quyền truy cập vào ảnh bìa cao cấp mới nhất về các sự kiện đang diễn ra tại thời điểm này hoặc trong quá khứ, người nổi tiếng và thời trang điện tử bằng cách cấp phép cho ảnh, clip Báo chí đơn lẻ hoặc gói 25 ảnh hoặc clip Báo chí. Chỉ cần nhấp vào nút \"Mua ngay\" màu đỏ hoặc \"Thêm vào giỏ hàng\" khi xem ảnh hoặc video clip để bắt đầu. Quyền truy cập Shutterstock Enterprise cũng được cấp cho các nhóm công ty lớn có mức sử dụng Nội dung báo chí khối lượng lớn. \u003clearnMoreLink\u003eTìm hiểu thêm.\u003c/learnMoreLink\u003e","pricing_faq:how_to_license_editorial_image_question":"Làm thế nào để cấp phép Ảnh báo chí?","pricing_faq:image_license_difference_answer":"Giấy phép tiêu chuẩn phù hợp với phần lớn các nhu cầu sử dụng và sáng tạo. Giấy phép nâng cao đem lại nhiều quyền sử dụng hơn để bạn dùng ảnh trong buôn bán hàng hóa, mẫu web, mẫu in và môi trường thương mại. Hãy truy cập trang \u003clicenseComparisonLink\u003eso sánh giấy phép\u003c/licenseComparisonLink\u003e của chúng tôi để biết thêm chi tiết.","pricing_faq:image_license_difference_answer_new":"Giấy phép tiêu chuẩn phù hợp với phần lớn các nhu cầu sử dụng và sáng tạo. Giấy phép nâng cao đem lại nhiều quyền sử dụng hơn để bạn có thể dùng ảnh trong buôn bán hàng hóa, mẫu web, mẫu in và môi trường thương mại. Hãy truy cập trang \u003ca href=\"__LICENSE_COMPARISON_LINK__\" target=\"_blank\"\u003eso sánh giấy phép\u003c/a\u003e của chúng tôi để biết thêm chi tiết. Nhấp vào liên kết để tìm hiểu thêm về các giấy phép \u003ca href=\"__VIDEO_LINK__\" target=\"_blank\"\u003evideo\u003c/a\u003e và \u003ca href=\"__MUSIC_LINK__\" target=\"_blank\"\u003eâm nhạc\u003c/a\u003e này.","pricing_faq:image_license_difference_question":"Giấy phép tiêu chuẩn và Giấy phép nâng cao có gì khác nhau?","pricing_faq:music_license_difference_answer":"Giấy phép tiêu chuẩn bao gồm quyền sử dụng mọi bản cắt đã chỉnh sửa và phiên bản ngôn ngữ của một sản phẩm duy nhất trên toàn thế giới cho các trang web, phương tiện truyền thông xã hội và trang web chia sẻ video trực tuyến (như YouTube và Vimeo, miễn là chi phí quảng cáo của bạn dưới 5.000 USD).  Giấy phép này cũng bao gồm các dự án của sinh viên như phim và kịch.  Giấy phép nâng cao bao gồm quyền sử dụng mọi bản cắt đã chỉnh sửa và phiên bản ngôn ngữ của một sản phẩm duy nhất tại một quốc gia. Quyền này áp dụng cho các quảng cáo trên TV hoặc radio, điểm bán hàng hoặc sản phẩm giải trí được thí điểm hoặc ủy quyền bởi và chỉ có sẵn thông qua một đài phát thanh công cộng. Giấy phép nâng cao cũng bao gồm phạm vi sử dụng trên toàn thế giới cho tối đa 1000 lượt tải xuống hoặc bản sao của một ứng dụng hay DVD, cũng như phạm vi đã nêu trong Giấy phép tiêu chuẩn cho cùng một sản phẩm. \u003clearnMoreLink\u003eTìm hiểu thêm tại đây\u003c/learnMoreLink\u003e.","pricing_faq:music_license_difference_question":"Giấy phép âm nhạc tiêu chuẩn và nâng cao có gì khác nhau?","pricing_faq:permission_to_use_editorial_for_commercial_answer":"Nội dung được gắn nhãn \"Chỉ được phép sử dụng cho mục đích báo chí\" đề cập đến nội dung ảnh và video không có giấy phép sử dụng ảnh người mẫu hay giấy phép sử dụng tài sản được lưu. Nội dung này thường được các đơn vị xuất bản và phương tiện truyền thông sử dụng, đồng thời không dành cho các mục đích thương mại từ trước đến nay. Với Asset Assurance™, đội ngũ biên tập viên và chuyên gia pháp lý của Shuttestock sẽ đánh giá mọi nội dung báo chí và làm việc với khách hàng để xem xét khả năng sử dụng nội dung này cho mục đích thương mại tiềm năng. Nếu cần thêm quyền miễn trừ, đội ngũ Quyền và Cấp quyền của chúng tôi sẽ giúp đảm bảo các quyền miễn trừ của bên thứ ba. Sau khi được chấp thuận về mặt pháp lý, các thương hiệu và doanh nghiệp có thể hiện thực hóa các chiến dịch của mình, cũng như đảm bảo có một khoản bồi thường cần thiết để sử dụng cho mục đích thương mại, giúp bảo vệ họ trước các khiếu nại tiềm ẩn về ảnh người mẫu hoặc tài sản.\n\u003ccontactUsLink\u003eLiên hệ với chúng tôi\u003c/contactUsLink\u003e để tìm hiểu thêm về việc sử dụng ảnh báo chí cho các chiến dịch của bạn.\n*Asset Assurance™ tuân theo đánh giá và phê duyệt về pháp lý của Shutterstock.","pricing_faq:permission_to_use_editorial_for_commercial_question":"Làm thế nào để xin phép sử dụng Nội dung báo chí cho mục đích thương mại?","pricing_faq:plan_cancellation_answer":"Bạn có thể quản lý và hủy gói đăng ký bất cứ lúc nào ngay trên trang Gói đăng ký.\nBạn sẽ phải trả phí hủy nếu cần hủy gói đăng ký có cam kết hàng năm trước hạn.\n\u003ccancellationOptionsLink\u003eTìm hiểu thêm về các tùy chọn hủy\u003c/cancellationOptionsLink\u003e","pricing_faq:plan_cancellation_answer_new":"Bạn có thể hủy gói đăng ký trước khi kết thúc thời hạn hợp đồng nhưng sẽ phải trả 50% chi phí đăng ký còn lại, trừ khi luật pháp địa phương yêu cầu chúng tôi cung cấp cho bạn phương án hủy và nhận tiền hoàn lại. Nếu gói đăng ký được đặt thành tự động gia hạn, bạn có thể tắt tính năng này bất cứ lúc nào trong phần cài đặt tài khoản để đảm bảo gói đăng ký không bị gia hạn khi kết thúc thời hạn hợp đồng.","pricing_faq:plan_cancellation_question":"Nếu không cần dùng nữa, tôi có thể hủy gói đăng ký không?","pricing_faq:plan_cancellation_question_new":"Tôi có thể hủy gói đăng ký không?","pricing_faq:plan_refund_answer":"Thông thường, Shutterstock không hoàn tiền cho giao dịch mua sau khi bạn hoàn tất thanh toán. Chúng tôi có thể hoàn tiền cho giao dịch mua do khách hàng Liên minh châu Âu và Vương quốc Anh thực hiện trong 14 ngày đầu tiên với điều kiện bạn chưa sử dụng tín dụng hoặc lượt tải xuống nào. Sau 14 ngày hoặc sau khi đã sử dụng gói đăng ký, bạn sẽ không đủ điều kiện để được hoàn tiền nữa. Vui lòng tham khảo \u003ctermsOfServiceLink\u003eĐiều khoản dịch vụ\u003c/termsOfServiceLink\u003e của chúng tôi để biết chi tiết.","pricing_faq:plan_refund_question":"Tôi có được hoàn tiền nếu hủy gói đăng ký không?","pricing_faq:purchase_subscription_or_on_demand_answer":"Gói theo yêu cầu là gói phù hợp nhất cho các nhu cầu thường xuyên thay đổi về tài sản. Bạn có thể sử dụng gói này trong vòng 12 tháng kể từ ngày mua. Gói đăng ký là lựa chọn linh hoạt nhất nếu bạn cần một nguồn nội dung mới đều đặn.","pricing_faq:purchase_subscription_or_on_demand_question":"Tôi nên mua gói đăng ký hay gói theo yêu cầu?","pricing_faq:upgrade_or_downgrade_image_plan_answer":"Bạn đã hết lượt phân bổ hàng tháng hoặc nhu cầu dùng ảnh đang cao hơn hoặc thấp hơn bình thường? Chúng tôi hiểu rằng nhu cầu có thể thay đổi. Bạn có thể \u003ccontactUsLink\u003eliên hệ với chúng tôi\u003c/contactUsLink\u003e, chúng tôi luôn sẵn sàng trợ giúp.","pricing_faq:upgrade_or_downgrade_image_plan_question":"Tôi có thể nâng cấp hay hạ cấp sang gói đăng ký khác không?","pricing_faq:upgrade_or_downgrade_video_plan_answer":"Bạn đã hết lượt phân bổ hằng tháng hoặc nhu cầu dùng video đang cao hơn hoặc thấp hơn bình thường? Chúng tôi hiểu rằng nhu cầu có thể thay đổi. Bạn có thể \u003ccontactUsLink\u003eliên hệ với chúng tôi\u003c/contactUsLink\u003e, chúng tôi luôn sẵn sàng trợ giúp.","pricing_faq:video_license_difference_answer":"Giấy phép tiêu chuẩn phù hợp với phần lớn các nhu cầu sử dụng và sáng tạo. Giấy phép nâng cao đem lại nhiều quyền sử dụng hơn. Nhờ đó, bạn có thể dùng video trong buôn bán hàng hóa, mẫu web, mẫu in và môi trường thương mại. Hãy truy cập trang \u003clicenseComparisonLink\u003eso sánh giấy phép\u003c/licenseComparisonLink\u003e của chúng tôi để biết thêm chi tiết.","pricing_faq:video_license_difference_question":"Giấy phép video tiêu chuẩn và Giấy phép video nâng cao có gì khác nhau?","pricing_faq:what_is_editorial_use_only_content_answer":"Bạn sẽ thấy nhiều ảnh, vector và video clip của Shutterstock được đánh dấu là \"Chỉ được phép sử dụng cho mục đích báo chí\", nghĩa là không được phép sử dụng nội dung này cho mục đích thương mại. Nội dung báo chí được sử dụng trên các phương tiện truyền thông tin tức và cho các mục đích phi thương mại khác.","pricing_faq:what_is_editorial_use_only_content_question":"Tại sao có một số nội dung được đánh dấu là \"Chỉ được phép sử dụng cho mục đích báo chí\"?","pricing_gen_ai_faq:availability_answer":"Điều đó tùy thuộc vào bạn. Chúng tôi cung cấp các gói đăng ký mặc định giữ riêng tư nội dung tạo ra, nếu bạn cần nắm quyền kiểm soát nhiều hơn. Tính năng này giúp toàn bộ nội dung từ AI chỉ giới hạn trong tổ chức của bạn. Trong các gói đăng ký khác, bạn có thể thêm nội dung đã tạo vào thư viện Shutterstock của chúng tôi, người khác có thể xem hoặc xin cấp phép nội dung này qua đó.","pricing_gen_ai_faq:availability_question":"Nếu tôi tạo nội dung thì nội dung đó có được cung cấp cho những khách hàng khác để sử dụng không?","pricing_gen_ai_faq:image_usage_answer":"Có – chỉ cần bạn xin cấp phép ảnh là được.\u003cbr/\u003e\u003cbr/\u003eBạn có thể sử dụng nội dung từ AI trong các dự án cá nhân hoặc thương mại nếu tải xuống cùng giấy phép phù hợp (ví dụ: Tiêu chuẩn, Nâng cao, Truyền thông hoặc Premier), giấy phép này xác định cách sử dụng tài sản và các biện pháp bảo vệ được áp dụng.\u003cbr/\u003e\u003cbr/\u003eBạn không được sử dụng ảnh để xâm phạm, chiếm đoạt hoặc vi phạm quyền sở hữu trí tuệ hoặc các quyền của bên khác bằng cách tạo thư rác, hình ảnh sai lệch, gây hiểu lầm, lừa đảo, độc hại hoặc bạo lực.\u003cbr/\u003e\u003cbr/\u003eVới một số gói đăng ký, bạn có thể yêu cầu con người đánh giá nội dung bạn tạo để yên tâm hơn. Nếu nội dung được phê duyệt, chúng tôi sẽ bồi thường trước mọi khiếu nại.\u003cbr/\u003e\u003cbr/\u003eĐọc thêm về các điều khoản của chúng tôi \u003ca href=\"__TOS_LINK__\" target=\"_blank\"\u003etại đây\u003c/a\u003e.","pricing_gen_ai_faq:image_usage_question":"Tôi có thể sử dụng những ảnh này cho dự án cá nhân hoặc dự án thương mại của mình không?","pricing_gen_ai_faq:ownership_answer":"Vì tính năng tạo bằng AI chuyên nghiệp (trong một số trường hợp hiếm hoi) có thể tạo ra kết quả tương tự giữa nhiều người dùng, chúng tôi không thể đảm bảo tính độc quyền. Tuy nhiên, kết quả tạo ra được định hình dựa trên gợi ý, cài đặt và lựa chọn mô hình độc nhất của bạn – vì vậy khả năng trùng lặp là rất thấp.\u003cbr/\u003e\u003cbr/\u003eNếu quyền sử dụng độc quyền rất quan trọng đối với dự án của bạn, hãy liên hệ với chúng tôi để khám phá các lựa chọn.","pricing_gen_ai_faq:ownership_question":"Nội dung tôi tạo có phải là của riêng tôi không?","pricing_gen_ai_faq:prompt_in_other_languages_answer":"Có! Chúng tôi cũng như toàn thể trang web của chúng tôi đều hỗ trợ hơn 20 ngôn ngữ. Ngay cả khi bạn nhập gợi ý bằng ngôn ngữ không được hỗ trợ chính thức, thì trình tạo ảnh bằng trí tuệ nhân tạo của chúng tôi cũng sẽ cố gắng hết sức để hiểu văn bản và trả về kết quả mỹ mãn.","pricing_gen_ai_faq:prompt_in_other_languages_question":"Có thể viết gợi ý bằng ngôn ngữ khác ngoài tiếng Anh không?","pricing_gen_ai_faq:report_results_answer":"Đây là công nghệ mới và có nhiều biến động, nghĩa là công nghệ này có thể tạo ra những kết quả không như mong muốn. Vui lòng sử dụng nút Phản hồi trên mỗi ảnh để báo cáo những kết quả mà chúng tôi cần chú ý.","pricing_gen_ai_faq:report_results_question":"Làm thế nào để báo cáo những kết quả có vẻ kỳ lạ/phản cảm/bất hợp pháp?","pricing_gen_ai_faq:safeguard_for_inappropriate_content_answer":"Chúng tôi có biện pháp bảo vệ nhằm tránh tạo ra tài liệu gây hại, bạo lực, lừa đảo hoặc độc hại khác. Tuy vậy, công nghệ này vẫn đang được phát triển và không phải lúc nào cũng chuẩn xác.\u003cbr/\u003e\u003cbr/\u003eVui lòng cho chúng tôi biết về mọi nội dung không phù hợp hoặc phản cảm bằng cách nhấn vào nút Phản hồi và cung cấp thông tin chi tiết về trải nghiệm của bạn.","pricing_gen_ai_faq:safeguard_for_inappropriate_content_question":"Có biện pháp bảo vệ nào đối với nội dung không phù hợp không?","pricing_gen_ai_faq:start_making_images_answer":"Dễ lắm – chỉ cần nhập ý tưởng của bạn vào ô gợi ý. Trong khoảng 10–15 giây, AI của chúng tôi sẽ tạo một bộ ảnh dựa trên văn bản bạn nhập. Bạn muốn nhận kết quả khác? Chỉ cần chỉnh sửa hoặc cải thiện gợi ý của bạn rồi thử lại. Bạn thích nội dung bạn nhìn thấy? Bạn có thể xin cấp phép ngay tức thì.\u003cbr/\u003e\u003cbr/\u003eMỗi người dùng đều nhận được 2 lần tạo ảnh miễn phí mỗi tháng. Bạn cần thêm? Ngoài ra còn có sẵn các gói linh hoạt để giúp bạn nâng tầm sức sáng tạo – cho cả cá nhân lẫn đội nhóm lớn.","pricing_gen_ai_faq:start_making_images_question":"Làm thế nào để bắt đầu tạo ảnh từ AI?","pricing_gen_ai_faq:title":"Chuyển văn bản thành hình ảnh bằng AI: Câu hỏi thường gặp","pricing_header:pro":"Gói Pro","pricing_modal:annual_plan_monthly_billed":"Gói đăng ký hàng năm, thanh toán theo tháng","pricing_modal:basic_image_editing":"Công cụ chỉnh sửa ảnh cơ bản","pricing_modal:downloads_expire_in_year":"Lượt tải xuống sẽ hết hạn sau một năm","pricing_modal:editorial_use_only_content":"\u003cpara\u003eChỉ được phép sử dụng cho mục đích báo chí. Không được sử dụng ảnh cho mục đích quảng cáo.\u003c/para\u003e\u003cpara\u003eCho phép sử dụng trên mọi phương tiện, ngoại trừ phát sóng, OTT/phát trực tuyến và bìa in.\u003c/para\u003e\u003cpara\u003eẢnh chỉ được sử dụng một lần theo ngữ cảnh. Vui lòng xin cấp phép lại để sử dụng thêm.\u003c/para\u003e\u003cpara\u003eTìm hiểu thêm trong \u003csupportCenterLink\u003eTrung tâm hỗ trợ\u003c/supportCenterLink\u003e và \u003ctermsOfServiceLink\u003eĐiều khoản dịch vụ\u003c/termsOfServiceLink\u003e của chúng tôi.\u003c/para\u003e\u003cpara\u003e\u003cbold\u003eBạn cần có thêm quyền hoặc quan tâm đến việc sử dụng cho mục đích thương mại?\u003c/bold\u003eTrao đổi cùng chúng tôi về \u003ccontactShutterstockEnterpriseLink\u003eShutterstock Enterprise\u003c/contactShutterstockEnterpriseLink\u003e\u003c/para\u003e","pricing_modal:editorial_use_only_title":"Giấy phép báo chí","pricing_modal:monthly_replenishment":"Bổ sung lượt tải xuống hàng tháng","pricing_modal:one_time_purchase":"Thanh toán một lần","pricing_modal_flex_read_more_2":"Công cụ chỉnh sửa ảnh cao cấp","pricing_modal_videos_library_description_with_worry_free_licensing":"Truy cập thư viện 30 triệu video clip chân thực, chất lượng cao – hoàn toàn an tâm cấp phép.","pricing_page:14k_design_templates":"Hơn 14 nghìn mẫu, phông chữ và logo","pricing_page:enhanced_image_license":"Giấy phép ảnh nâng cao","pricing_page:image_enhanced_license_1":"Bao gồm giấy phép tiêu chuẩn cùng nhiều tính năng khác","pricing_page:image_enhanced_license_2":"Phân phối web không giới hạn","pricing_page:image_enhanced_license_3":"Không giới hạn số bản in","pricing_page:image_enhanced_license_4":"Không giới hạn số bản in quảng cáo ngoài trời (OOH)","pricing_page:image_enhanced_license_5":"Được phép sử dụng trên hàng hóa và bao bì","pricing_page:image_enhanced_license_6":"Được phép sử dụng trong mẫu web, sản xuất video với ngân sách bất kỳ, trang trí không gian cá nhân và thương mại cũng như bồi thường pháp lý lên đến __VALUE__ USD.","pricing_page:image_standard_license_1":"Phù hợp với phần lớn các nhu cầu sử dụng và sáng tạo","pricing_page:image_standard_license_2":"Phân phối web không giới hạn","pricing_page:image_standard_license_3":"Số bản in lên đến 500.000 bản","pricing_page:image_standard_license_4":"Tối đa 500.000 bản in quảng cáo ngoài trời (OOH)","pricing_page:image_standard_license_5":"Có hạn chế đối với trường hợp sử dụng trên hàng hóa và bao bì","pricing_page:image_standard_license_6":"Có hạn chế đối với trường hợp sử dụng trong mẫu web, mẫu bản in, môi trường thương mại cũng như bồi thường pháp lý lên đến __VALUE__ USD.","pricing_page:standard_image_license":"Giấy phép ảnh tiêu chuẩn","pricing_tab_options_3d":"Tài sản 3D","pricing_tab_options_ai_gen":"Ảnh do trí tuệ nhân tạo xây dựng","pricing_tab_options_images":"Ảnh","pricing_tab_options_music":"Nhạc","pricing_tab_options_sound_effects":"Hiệu ứng âm thanh","print_run_copies":"Số bản in","rebrand_feature_matrix:access_to_leading_ai_models":"Truy cập vào những mô hình AI hàng đầu","rebrand_feature_matrix:ai_editing_capabilities":"Khả năng chỉnh sửa bằng AI","rebrand_feature_matrix:ai_editing_tools_tooltip":"Cọ ma thuật, Mở rộng ảnh, Biến tấu và Trình xóa nền.","rebrand_feature_matrix:ai_models_tooltip":"Runway, Google Veo, Dall-E 3, Google Imagen, v.v.","rebrand_feature_matrix:ai_video_generation":"Lần tạo video bằng AI","rebrand_feature_matrix:content_research_access":"Truy cập vào các nghiên cứu về nội dung và bản xem trước không có dấu bản quyền mà bạn có thể tải xuống","rebrand_feature_matrix:dedicated_account_management":"Quản lý và hỗ trợ tài khoản chuyên dụng","rebrand_feature_matrix:enhanced_license_tooltip":"Đem lại nhiều quyền sử dụng hơn để bạn có thể dùng ảnh trong buôn bán hàng hóa, mẫu web, mẫu in và môi trường thương mại. \u003cbutton\u003eXem thêm thông tin\u003c/button\u003e","rebrand_feature_matrix:flexible_plans":"Gói đăng ký linh hoạt đáp ứng nhu cầu của bạn","rebrand_feature_matrix:genai_and_model_access":"GenAI và quyền truy cập mô hình","rebrand_feature_matrix:human_content_review":"Đánh giá nội dung thủ công để đảm bảo an toàn về thương hiệu và pháp lý","rebrand_feature_matrix:image_editing_tools":"Công cụ chỉnh sửa ảnh","rebrand_feature_matrix:image_generation":"Lần tạo ảnh","rebrand_feature_matrix:included_select_plans":"Có trong một số gói đăng ký","rebrand_feature_matrix:media_premier_licenses":"Giấy phép truyền thông/Premier","rebrand_feature_matrix:private_ai_generations":"Lần tạo riêng tư bằng AI (không công khai hoặc chia sẻ)","rebrand_feature_matrix:standard_license_tooltip":"Phù hợp với hầu hết các nhu cầu sáng tạo. \u003cbutton\u003eXem thêm thông tin\u003c/button\u003e","rebrand_feature_matrix:tailored_solutions_tooltip":"Mang lại sự linh hoạt cao hơn và được thiết kế để tạo ra nhiều giải pháp riêng biệt.","rebrand_feature_matrix:trust_and_protection":"Uy tín và sự che chở","restricted":"Giới hạn","specific_licensing_rights":"Quyền cấp phép cụ thể","standard_license":"Giấy phép tiêu chuẩn","standard_vs_enhanced_license":"Giấy phép tiêu chuẩn hoặc Giấy phép nâng cao","standard_vs_enhanced_license_description":"Giấy phép tiêu chuẩn đáp ứng trên cả yêu cầu đối với phần lớn các dự án – song bạn còn làm được nhiều hơn thế với Giấy phép nâng cao.","subscription":"Gói đăng ký","subscriptions":"Gói đăng ký","talk_to_us":"Trao đổi với chúng tôi","team-admin-modal:contact_admin_modal_contact_your_admin":"Liên hệ với quản trị viên của bạn","team-admin-modal:contact_admin_modal_only_admin_can_purchase_contact_admin_name":"Chỉ có quản trị viên nhóm mới có thể thanh toán. Vui lòng liên hệ với quản trị viên của bạn, \u003cb\u003e__ADMIN_NAME__\u003c/b\u003e, để thực hiện giao dịch mua này.","team-admin-modal:contact_admin_modal_only_admin_can_purchase_contact_your_admin":"Chỉ có quản trị viên nhóm mới có thể thanh toán. Vui lòng liên hệ với quản trị viên của bạn để thực hiện giao dịch mua này.","team-admin-modal:contact_us_further_assistance":"\u003ca\u003eHãy liên hệ với chúng tôi\u003c/a\u003e nếu bạn cần hỗ trợ thêm","teams":"Nhóm","unlimited":"Không giới hạn","up_to_value":"Tối đa __VALUE__","usage":"Tần suất sử dụng","usage_type_enterprise":"Doanh nghiệp","video_enhanced_license_1":"Phân phối không giới hạn trên trang web, phương tiện truyền thông xã hội, ứng dụng","video_enhanced_license_2":"Không giới hạn bản in quảng cáo ngoài trời","video_enhanced_license_3":"Không giới hạn số lượng khán giả đối với các buổi biểu diễn trực tiếp","video_enhanced_license_4":"Phân phối không giới hạn trên truyền hình, video trực tuyến và phim ảnh","video_enhanced_license_5":"Sử dụng không giới hạn cho các mẫu web kỹ thuật số","video_license_common":"Sử dụng không giới hạn trên các trang web","video_production":"Sản xuất video","video_standard_license_1":"Tối đa __VALUE__ khán giả trên trang web, mạng xã hội, ứng dụng","video_standard_license_2":"Tối đa __VALUE__ bản in quảng cáo ngoài trời","video_standard_license_3":"Tối đa __VALUE__ khán giả cho các buổi biểu diễn trực tiếp","video_standard_license_4":"Không phân phối trên truyền hình hoặc phim ảnh","videos":"Video","web_distribution":"Phân phối web"},"search":{"banner_button_genai":"Bắt đầu tạo","common:actions_new":"New","genai_pro_search_grid_item_hint":"Mẹo: Thêm phong cách, tâm trạng hoặc định dạng để nhận được kết quả mỹ mãn hơn","genai_pro_search_grid_item_label":"Tạo chính xác nội dung bạn cần với GenAI!","genai_pro_search_grid_item_placeholder":"Nhập nội dung bạn đang tìm kiếm…","genai_pro_tile_subtitle":"Không cần lướt xem – Tạo những hình ảnh tuyệt đẹp độc nhất vô nhị ngay tức thì với trình tạo ảnh bằng AI.","genai_pro_tile_title":"Bạn không tìm được ảnh phù hợp?","generate:search_cross_content_link":"Hãy khám phá trình tạo ảnh bằng trí tuệ nhân tạo của chúng tôi để chuyển đổi văn bản thành hình ảnh đẹp mắt.","generate:search_subtitle":"Bạn đang tìm kiếm ảnh do trí tuệ nhân tạo xây dựng?","image:hide_description":"Ẩn mô tả đầy đủ","image:related_searches":"Nội dung tìm kiếm liên quan:","image:related_term_searches":"Nội dung tìm kiếm liên quan đến __SEARCH_TERM__","image:search_cross_content_link":"Xem video, clip có sẵn về __SEARCH_TERM__","image:search_did_you_mean":"Ý bạn là __CORRECTED_SEARCH_TERM__?","image:search_ids_page_title":"Tìm kiếm bằng ID","image:search_ids_title":"Hiển thị kết quả cho __IDS__","image:search_ids_title_count":"Hiển thị kết quả cho __IDS__ và __IDS_COUNT__ ID khác","image:search_meta_description":"Tìm kiếm ảnh HD có sẵn và hàng triệu vector, hình minh họa, đối tượng 3D và ảnh có sẵn miễn phí bản quyền về __SEARCH_TERM__ trong bộ sưu tập của Shutterstock.  Mỗi ngày có thêm hàng nghìn ảnh mới với chất lượng cao.","image:search_meta_description_no_search_term":"Tìm kiếm ảnh HD có sẵn và hàng triệu vector, hình minh họa, đối tượng 3D và ảnh có sẵn miễn phí bản quyền trong bộ sưu tập của Shutterstock.  Mỗi ngày có thêm hàng nghìn ảnh mới với chất lượng cao.","image:search_meta_description_variant_1":"Tìm kiếm __QUANTIFIER__ ảnh HD có sẵn về __SEARCH_TERM__ và hàng triệu vector, hình minh họa, đối tượng 3D và ảnh có sẵn miễn phí bản quyền khác trong bộ sưu tập của Shutterstock. Mỗi ngày có thêm hàng nghìn ảnh mới với chất lượng cao.","image:search_meta_title_3d-object":"Tải xuống đối tượng 3D về __SEARCH_TERM__ chất lượng nhất, sẵn sàng cấp phép với hơn __COUNT__ ảnh 3D miễn phí bản quyền về __SEARCH_TERM__","image:search_meta_title_3d-object_no_search_term":"Tải xuống đối tượng 3D chất lượng nhất, sẵn sàng cấp phép với hơn __COUNT__ ảnh 3D miễn phí bản quyền","image:search_meta_title_allimages":"\"__SEARCH_TERM__\" – __COUNT__ Ảnh, vector, đối tượng 3D và hình chụp có sẵn | Shutterstock","image:search_meta_title_allimages_international":"__SEARCH_TERM__ : __QUANTIFIER__ ảnh, hình ảnh có sẵn và ảnh miễn phí bản quyền | Shutterstock","image:search_meta_title_allimages_no_search_term":"Ảnh, vector, đối tượng 3D và hình chụp có sẵn | Shutterstock","image:search_meta_title_generated":"__SEARCH_TERM__: Hơn __COUNT__ ảnh do trí tuệ nhân tạo xây dựng, miễn phí bản quyền và có thể cấp phép | Shutterstock","image:search_meta_title_generated_no_search_term":"Ảnh do trí tuệ nhân tạo xây dựng, miễn phí bản quyền và có thể cấp phép | Shutterstock","image:search_meta_title_illustrations":"__SEARCH_TERM__: Hơn __COUNT__ hình minh họa và hình vẽ có sẵn miễn phí bản quyền có thể cấp phép | Shutterstock","image:search_meta_title_illustrations_no_search_term":"Hình minh họa và hình vẽ có sẵn miễn phí bản quyền có thể cấp phép | Shutterstock","image:search_meta_title_photos":"__SEARCH_TERM__: Hơn __COUNT__ ảnh có sẵn miễn 