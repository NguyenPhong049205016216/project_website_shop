for_individuals":"Phù hợp cho những cá nhân cần…","plan_compare_modal:library_size":"Kích cỡ thư viện","plan_compare_modal:monthly_billed_and_terms_of_service":"*Gói đăng ký hằng năm, thanh toán theo tháng. Có áp dụng phí hủy. Để xem đầy đủ thông tin chi tiết về các loại giấy phép và các tính năng có trong giấy phép, vui lòng xem \u003ca href=\"__TOS_LINK__\" target=\"_blank\"\u003eĐiều khoản dịch vụ\u003c/a\u003e của chúng tôi.","plan_compare_modal:no":"Không","plan_compare_modal:number_million_assets":"Hơn __NUMBER__ triệu tài sản","plan_compare_modal:number_million_images":"Hơn __NUMBER__ triệu ảnh","plan_compare_modal:number_million_videos":"Hơn __NUMBER__ triệu video","plan_compare_modal:number_thousand_music_tracks":"Hơn __NUMBER__ nghìn bài nhạc","plan_compare_modal:number_videos_per_month":"__NUMBER__ video mỗi tháng","plan_compare_modal:occasional_projects":"Ảnh cho các dự án vào dịp đặc biệt","plan_compare_modal:occasional_projects_music":"Bài nhạc cho các dự án vào dịp đặc biệt","plan_compare_modal:occasional_projects_videos":"Video cho các dự án vào dịp đặc biệt","plan_compare_modal:price_per_month":"__PRICE__/tháng","plan_compare_modal:see_all_pricing":"Xem tất cả giá cước","plan_compare_modal:single_hd_video":"Một video HD","plan_compare_modal:ten_images_per_month":"__NUMBER__ ảnh mỗi tháng","plan_compare_modal:terms":"Điều khoản","plan_compare_modal:unlimited_assets":"Tài sản không giới hạn","plan_compare_modal:unlimited_images":"Ảnh Không giới hạn","plan_compare_modal:variety_of_image_video_music_assets":"Đa dạng tài sản ảnh, video và âm nhạc","plan_compare_modal:yes":"Có","plan_name:single_track":"Một bài nhạc","plan_name:unlimited_download_subscription":"Gói đăng ký lượt tải xuống không giới hạn","plan_name:unlimited_subscription":"Gói đăng ký không giới hạn","plan_name:video_5_pack":"Gói 5 video","plan_name:video_5_sub":"Gói đăng ký 5 video","plan_name:video_pack":"Gói video","premium_music_description_paragraph_1":"Truy cập các bài nhạc PremiumBeat và lượt tải xuống bài nhạc không giới hạn, bao gồm clip ngắn và nhạc phát lặp lại để bạn có thể tập trung vào tầm nhìn sáng tạo thay vì bận tâm đến ngân sách.","premium_music_description_paragraph_2":"Bao gồm Giấy phép tiêu chuẩn đáp ứng nhu cầu sử dụng trên web – video YouTube, mạng xã hội, podcast, v.v. – cũng như các hội nghị, điểm bán hàng, triển lãm thương mại và nhiều trường hợp sử dụng khác.","premium_music_subscription":"Gói đăng ký nhạc Premium","price_billed_monthly_for_one_year":"*Thanh toán __PRICE__ mỗi tháng trong 1 năm","price_no_commitment":"__PRODUCT_PRICE__, không bắt cam kết","price_paid_upfront":"Trả trước __PRODUCT_PRICE__","price_per_month":"__PRODUCT_PRICE__/tháng*","price_per_month_first_month":"__PRODUCT_PRICE__ cho tháng đầu tiên","price_per_month_for_one_year":"__PRODUCT_PRICE__/tháng trong 1 năm","price_per_month_for_one_year_with_cancellation_fee":"__PRODUCT_PRICE__/tháng trong 1 năm. Có áp dụng phí hủy trước hạn.","price_per_year":"__PRODUCT_PRICE__/năm","price_with_no_commitment":"__PRODUCT_PRICE__, không bắt cam kết","pricing_page:cancellation_fee_applies":"Có áp dụng phí hủy. Xem \u003ca\u003eđiều khoản và điều kiện\u003c/a\u003e.","purchase":"Mua","save_discount":"Tiết kiệm __DISCOUNT__%","see_all_image_plans":"Xem tất cả gói ảnh","see_all_our_pricing_plans":"Xem tất cả gói giá cước của chúng tôi","see_all_pricing_details":"Xem toàn bộ chi tiết giá cước","see_all_pricing_plans":"Xem tất cả gói giá cước","see_more_pricing_plans":"Xem thêm gói giá cước","see_more_purchase_options":"Xem thêm các tùy chọn mua hàng","select_size_format":"Lựa chọn kích cỡ/định dạng","standard_license_description":"Sử dụng không giới hạn trong in ấn, quảng cáo và đóng gói. Phân phối web không giới hạn.","subscribe_now_get_ai_gen":"Đăng ký ngay để nhận 100 lần tạo bằng AI mỗi tháng.","supplemental":"Bổ sung","unlimited_ai_generations":"100 lần tạo bằng AI mỗi tháng","unlimited_ai_generations_credits":"100 tín dụng tạo nội dung bằng AI mỗi tháng","unlimit